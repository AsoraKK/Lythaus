# Lythaus local environment template
# Do not commit real secrets.

# Runtime
NODE_ENV=development
LYTHAUS_ENVIRONMENT=development
JWT_SECRET=
JWT_ISSUER=lythaus-auth
INVITE_CODE_PEPPER=

# Canonical PostgreSQL access
DATABASE_URL=

# Email delivery
EMAIL_PROVIDER_MODE=log
EMAIL_FROM_ADDRESS=no-reply@mail.lythaus.co
EMAIL_FROM_NAME=Lythaus

# Notifications
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Authenticity evaluation
AUTHENTICITY_AI_ENABLED=false
AUTHENTICITY_AI_GATEWAY_ID=lythaus-ai
AUTHENTICITY_AI_MONTHLY_BUDGET_USD=25

# Public application URLs
CORS_ALLOWED_ORIGINS=https://app.lythaus.co,https://admin.lythaus.co
WEB_BASE_URL=https://app.lythaus.co
API_BASE_URL=https://api.lythaus.co/api
AUTH_URL=https://api.lythaus.co/api
ADMIN_API_URL=https://admin-api.lythaus.co/api
MARKETING_BASE_URL=https://lythaus.co
