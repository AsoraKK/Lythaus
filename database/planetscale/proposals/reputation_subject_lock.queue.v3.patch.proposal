diff --git a/apps/lythaus-jobs/src/reputation-deleted-terminal.ts b/apps/lythaus-jobs/src/reputation-deleted-terminal.ts
new file mode 100644
--- /dev/null
+++ b/apps/lythaus-jobs/src/reputation-deleted-terminal.ts
@@ -0,0 +1,20 @@
+import {
+  transactionWithVerifiedFailureCleanup, verifiedTransactionFailureCause,
+  isReputationSubjectDeletedError, type DatabaseClient, type HyperdriveBinding,
+} from '@lythaus/db';
+
+// Own the transaction call: a thrown domain error alone is never terminal proof.
+// The outer consumer completes other stages, then marks inbox/acks once.
+export async function runReputationTransaction(
+  binding: HyperdriveBinding,
+  work: (client: DatabaseClient) => Promise<unknown>,
+): Promise<'processed' | 'deleted'> {
+  try {
+    await transactionWithVerifiedFailureCleanup(binding, work);
+    return 'processed';
+  } catch (error) {
+    const verified = verifiedTransactionFailureCause(error);
+    if (!verified || !isReputationSubjectDeletedError(verified.cause)) throw error;
+    return 'deleted';
+  }
+}
