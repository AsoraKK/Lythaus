CREATE SCHEMA IF NOT EXISTS evaluation;

CREATE TABLE evaluation.posting_feedback_probe_samples (
  sample_id uuid PRIMARY KEY CHECK (substring(sample_id::text FROM 15 FOR 1) = '7'),
  input_hash text NOT NULL CHECK (input_hash ~ '^[0-9a-f]{64}$'),
  revision integer NOT NULL CHECK (revision > 0),
  UNIQUE (sample_id, input_hash, revision)
);

