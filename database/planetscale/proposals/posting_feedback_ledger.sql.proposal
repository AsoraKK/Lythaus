CREATE TABLE evaluation.posting_feedback_probe_runs (
  run_fingerprint text PRIMARY KEY
    CHECK (run_fingerprint ~ '^[0-9a-f]{64}$'),
  selection_hash text NOT NULL
    CHECK (selection_hash = 'c8882fa321e8e0073a5859814dcc86287651aa2d3b9b3170b16bd009cd6e1ed6'),
  source_sha text NOT NULL CHECK (source_sha ~ '^[0-9a-f]{40}$'),
  collector_hash text NOT NULL CHECK (collector_hash ~ '^[0-9a-f]{64}$'),
  provider text NOT NULL CHECK (provider = 'openai'),
  requested_model text NOT NULL CHECK (requested_model = 'omni-moderation-latest'),
  claimed_at timestamptz NOT NULL DEFAULT statement_timestamp(),
  UNIQUE (selection_hash, source_sha, collector_hash, provider, requested_model)
);

CREATE TABLE evaluation.posting_feedback_attempt_claims (
  run_fingerprint text NOT NULL
    REFERENCES evaluation.posting_feedback_probe_runs(run_fingerprint) ON DELETE RESTRICT,
  sample_id uuid NOT NULL
    CHECK (substring(sample_id::text FROM 15 FOR 1) = '7'),
  input_hash text NOT NULL CHECK (input_hash ~ '^[0-9a-f]{64}$'),
  revision integer NOT NULL CHECK (revision > 0),
  state text NOT NULL DEFAULT 'STARTED_NO_REPLAY'
    CHECK (state IN ('STARTED_NO_REPLAY', 'RECEIPT_COMMITTED')),
  claimed_at timestamptz NOT NULL DEFAULT statement_timestamp(),
  receipt_committed_at timestamptz,
  PRIMARY KEY (run_fingerprint, sample_id),
  FOREIGN KEY (sample_id, input_hash, revision)
    REFERENCES evaluation.posting_feedback_probe_samples(sample_id, input_hash, revision) ON DELETE RESTRICT,
  CHECK ((state = 'STARTED_NO_REPLAY' AND receipt_committed_at IS NULL)
      OR (state = 'RECEIPT_COMMITTED' AND receipt_committed_at IS NOT NULL))
);

CREATE TABLE evaluation.posting_feedback_results (
  run_fingerprint text NOT NULL,
  sample_id uuid NOT NULL,
  schema_version text NOT NULL
    CHECK (schema_version = 'lythaus-bounded-moderation-receipt-v1'),
  evidence_class text NOT NULL
    CHECK (evidence_class IN ('ACTUAL_PROVIDER_OBSERVATION', 'SYNTHETIC_TRANSPORT_TEST_ONLY')),
  input_class text NOT NULL
    CHECK (input_class = 'ARTIFICIAL_AGENT_WRITTEN_NOT_HUMAN_GROUND_TRUTH'),
  provider text NOT NULL CHECK (provider = 'openai'),
  requested_model text NOT NULL CHECK (requested_model = 'omni-moderation-latest'),
  response_model text
    CHECK (response_model IS NULL OR response_model ~ '^omni-moderation-[a-z0-9.-]{1,80}$'),
  provider_snapshot_known boolean NOT NULL DEFAULT false CHECK (provider_snapshot_known = false),
  response_hash text CHECK (response_hash IS NULL OR response_hash ~ '^[0-9a-f]{64}$'),
  http_status integer CHECK (http_status IS NULL OR http_status BETWEEN 100 AND 599),
  adapter_status text NOT NULL CHECK (adapter_status IN ('ALLOW', 'REVIEW', 'BLOCK', 'PROVIDER_FAILURE')),
  adapter_accepted boolean NOT NULL,
  evidence_schema text
    CHECK (evidence_schema IS NULL OR evidence_schema = 'lythaus-moderation-provider-evidence-v1'),
  schema_valid boolean NOT NULL,
  provider_flagged boolean,
  adapter_flagged boolean,
  safety_band text NOT NULL CHECK (safety_band IN ('REVIEW', 'ALLOW_EVIDENCE', 'ABSTAIN')),
  delivery_status text NOT NULL
    CHECK (delivery_status IN ('RESPONSE_CAPTURED', 'UNKNOWN_NO_RETRY', 'NOT_SENT')),
  transport_calls smallint NOT NULL CHECK (transport_calls BETWEEN 0 AND 1),
  actual_provider_requests smallint NOT NULL CHECK (actual_provider_requests BETWEEN 0 AND 1),
  failure_code text CHECK (failure_code IS NULL OR failure_code IN (
    'MISSING_CREDENTIAL', 'EMPTY_INPUT', 'INVALID_MIME', 'IMAGE_SIZE_LIMIT_EXCEEDED',
    'HTTP_AUTHENTICATION_FAILURE', 'HTTP_RATE_LIMITED', 'HTTP_SERVER_FAILURE', 'HTTP_FAILURE',
    'TIMEOUT', 'NETWORK_FAILURE', 'MALFORMED_RESPONSE', 'UNEXPECTED_SCHEMA',
    'RESPONSE_SIZE_LIMIT_EXCEEDED', 'INTERRUPTED_OR_TIMEOUT',
    'TRANSPORT_OR_RESPONSE_READ_FAILURE', 'EVALUATION_SCHEMA_OR_CONSISTENCY_FAILURE',
    'UNCLASSIFIED_FAILURE'
  )),
  execution_ms numeric(12, 3) NOT NULL CHECK (execution_ms BETWEEN 0 AND 600000),
  explanation_code text NOT NULL CHECK (explanation_code IN (
    'PROVIDER_FLAGS_ONLY_NO_AUTHORSHIP_OR_PUBLICATION_AUTHORITY',
    'NO_USABLE_SAFETY_RESULT_STOP_WITHOUT_RETRY'
  )),
  score_interpretation text NOT NULL DEFAULT 'UNCALIBRATED_PROVIDER_SCORE'
    CHECK (score_interpretation = 'UNCALIBRATED_PROVIDER_SCORE'),
  captured_at timestamptz NOT NULL,
  expires_at timestamptz NOT NULL,
  PRIMARY KEY (run_fingerprint, sample_id),
  FOREIGN KEY (run_fingerprint, sample_id)
    REFERENCES evaluation.posting_feedback_attempt_claims(run_fingerprint, sample_id) ON DELETE RESTRICT,
  CHECK (expires_at - captured_at = interval '7 days'),
  CHECK (actual_provider_requests <= transport_calls),
  CHECK ((evidence_class = 'SYNTHETIC_TRANSPORT_TEST_ONLY' AND actual_provider_requests = 0)
      OR (evidence_class = 'ACTUAL_PROVIDER_OBSERVATION' AND actual_provider_requests = transport_calls)),
  CHECK ((delivery_status = 'NOT_SENT' AND transport_calls = 0 AND response_hash IS NULL)
      OR (delivery_status = 'RESPONSE_CAPTURED' AND transport_calls = 1 AND response_hash IS NOT NULL)
      OR (delivery_status = 'UNKNOWN_NO_RETRY' AND transport_calls = 1 AND response_hash IS NULL))
);

CREATE TABLE evaluation.posting_feedback_result_categories (
  run_fingerprint text NOT NULL,
  sample_id uuid NOT NULL,
  category text NOT NULL CHECK (category IN (
    'harassment', 'harassment/threatening', 'hate', 'hate/threatening', 'illicit',
    'illicit/violent', 'self-harm', 'self-harm/instructions', 'self-harm/intent',
    'sexual', 'sexual/minors', 'violence', 'violence/graphic'
  )),
  provider_flag boolean,
  provider_score numeric CHECK (provider_score IS NULL OR provider_score BETWEEN 0 AND 1),
  input_types_observed boolean NOT NULL DEFAULT false,
  applied_input_types text[] NOT NULL DEFAULT '{}'
    CHECK (cardinality(applied_input_types) <= 2
      AND applied_input_types <@ ARRAY['text', 'image']::text[]
      AND (input_types_observed OR cardinality(applied_input_types) = 0)),
  PRIMARY KEY (run_fingerprint, sample_id, category),
  FOREIGN KEY (run_fingerprint, sample_id)
    REFERENCES evaluation.posting_feedback_results(run_fingerprint, sample_id) ON DELETE CASCADE,
  CHECK (provider_flag IS NOT NULL OR provider_score IS NOT NULL OR input_types_observed)
);

CREATE INDEX posting_feedback_results_expiry_idx
  ON evaluation.posting_feedback_results (expires_at);

COMMENT ON TABLE evaluation.posting_feedback_probe_runs IS
  'Minimal no-replay tombstones for one frozen synthetic moderation probe; not user content.';
COMMENT ON TABLE evaluation.posting_feedback_probe_samples IS
  'The exact immutable first-20 artificial fixtures and SHA-256 body bindings approved for this proposal.';
COMMENT ON TABLE evaluation.posting_feedback_attempt_claims IS
  'One durable pre-call claim per frozen run/sample. Claims are never expired by result cleanup.';
COMMENT ON TABLE evaluation.posting_feedback_results IS
  'Sanitized allowlisted moderation observations with a proposed seven-day result lifetime.';
COMMENT ON TABLE evaluation.posting_feedback_result_categories IS
  'Provider category flags, scores, and applied modalities; scores are not calibrated probabilities.';

