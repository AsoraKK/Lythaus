diff --git a/apps/lythaus-jobs/src/reputation-deleted-terminal.ts b/apps/lythaus-jobs/src/reputation-deleted-terminal.ts
new file mode 100644
--- /dev/null
+++ b/apps/lythaus-jobs/src/reputation-deleted-terminal.ts
@@ -0,0 +1,15 @@
+import { isReputationSubjectDeletedError } from '@lythaus/db';
+
+// Catch only after transaction() has rolled back and released its connection.
+// The outer consumer still completes other stages, then marks inbox/acks once.
+export async function runReputationTransaction(
+  work: () => Promise<unknown>,
+): Promise<'processed' | 'deleted'> {
+  try {
+    await work();
+    return 'processed';
+  } catch (error) {
+    if (!isReputationSubjectDeletedError(error)) throw error;
+    return 'deleted';
+  }
+}
