      "value": "\nBEGIN\n  IF pg_catalog.current_setting('transaction_isolation') <> 'read committed' THEN\n    RAISE EXCEPTION USING ERRCODE = '25000', MESSAGE = 'reputation_lock_isolation_unsupported';\n  END IF;\n  RETURN QUERY SELECT users.status FROM identity.users AS users\n  WHERE users.id = p_subject_id\n  FOR UPDATE OF users;\nEND;\n"
