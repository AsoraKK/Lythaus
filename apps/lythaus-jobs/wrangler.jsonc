{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lythaus-jobs-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "observability": { "enabled": true, "head_sampling_rate": 0.25 },
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "production",
    "HYPERDRIVE_QUERY_CACHE_MODE": "disabled",
    "AUTHENTICITY_AI_ENABLED": "true",
    "AUTHENTICITY_SHADOW_MODE": "true",
    "AUTHENTICITY_ENFORCEMENT_ENABLED": "false",
    "AUTHENTICITY_TEXT_MODEL": "@cf/openai/gpt-oss-20b",
    "AUTHENTICITY_IMAGE_MODEL": "@cf/openai/gpt-oss-20b",
    "EXTERNAL_BACKUP_HEALTHCHECK_URL": "REPLACE_WITH_EXTERNAL_BACKUP_HEALTHCHECK_URL",
    "R2_ACCOUNT_ID": "e5b7ae46e04698f507b7e4b3d4ef1af0",
    "MEDIA_PROCESSING_ENABLED": "false",
    "MEDIA_QUARANTINE_BUCKET": "lythaus-media-quarantine-dev",
    "MEDIA_APPROVED_BUCKET": "lythaus-media-approved-dev",
    "EXPECTED_DATABASE_TARGET": "main",
    "EXPECTED_DATABASE_SCHEMA_FINGERPRINT": "REPLACE_WITH_POST_0012_SCHEMA_FINGERPRINT",
    "EXPECTED_DATABASE_RELATION_COUNT": "REPLACE_WITH_POST_0012_RELATION_COUNT",
    "EXPECTED_DATABASE_SCHEMA_VERSION": "0012_product_integrity_v2.sql",
    "EXPECTED_DATABASE_ROLE_CLASS": "login_non_superuser",
    "EXPECTED_DATABASE_BUDGET_LEDGER_APPLIED": "true",
    "AUTHENTICATED_ACCEPTANCE_PROVEN": "false",
    "COST_BUDGET_ENABLED": "true",
    "COST_BUDGET_LIMIT_USD": "10",
    "COST_BUDGET_WARNING_USD": "5",
    "COST_BUDGET_OPTIONAL_ANALYSIS_USD": "7",
    "COST_BUDGET_ESSENTIAL_ONLY_USD": "8",
    "COST_BUDGET_DEEP_SCAN_STOP_USD": "9",
    "COST_AUTHENTICITY_TEXT_ESTIMATE_USD": "0.004",
    "COST_AUTHENTICITY_IMAGE_ESTIMATE_USD": "0.01",
    "AI_GATEWAY_ID": "lythaus-ai"
  },
  "hyperdrive": [
    { "binding": "DB_JOBS_FRESH", "id": "442bb04b99004cb38c6974ec031d65ee" },
    { "binding": "DB_PRIVACY_FRESH", "id": "bae909aa72e244bfa9b8ca8a948053b6" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_QUARANTINE", "bucket_name": "lythaus-media-quarantine-dev" },
    { "binding": "MEDIA_APPROVED", "bucket_name": "lythaus-media-approved-dev" },
    { "binding": "PRIVATE_EXPORTS", "bucket_name": "lythaus-private-exports-dev" },
    { "binding": "AUDIT_ARCHIVE", "bucket_name": "lythaus-audit-archive-dev" }
  ],
  "kv_namespaces": [
    { "binding": "LYTHAUS_CONFIG", "id": "b02289a521bd40bd9112335a3e763b11" }
  ],
  "queues": {
    "producers": [
      { "binding": "MODERATION_QUEUE", "queue": "lythaus-moderation-dev" },
      { "binding": "FEED_QUEUE", "queue": "lythaus-feed-dev" },
      { "binding": "PRIVACY_QUEUE", "queue": "lythaus-privacy-dev" },
      { "binding": "AUDIT_QUEUE", "queue": "lythaus-audit-dev" }
    ],
    "consumers": [
      { "queue": "lythaus-moderation-dev", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-moderation-dlq-dev" },
      { "queue": "lythaus-feed-dev", "max_batch_size": 25, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-feed-dlq-dev" },
      { "queue": "lythaus-privacy-dev", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-privacy-dlq-dev" },
      { "queue": "lythaus-audit-dev", "max_batch_size": 25, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-audit-dlq-dev" }
    ]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "workflows": [
    { "name": "lythaus-account-delete-dev", "binding": "ACCOUNT_DELETE", "class_name": "AccountDeleteWorkflow" },
    { "name": "lythaus-account-export-dev", "binding": "ACCOUNT_EXPORT", "class_name": "AccountExportWorkflow" },
    { "name": "lythaus-retention-cleanup-dev", "binding": "RETENTION_CLEANUP", "class_name": "RetentionCleanupWorkflow" },
    { "name": "lythaus-appeal-lifecycle-dev", "binding": "APPEAL_LIFECYCLE", "class_name": "AppealLifecycleWorkflow" },
    { "name": "lythaus-backup-validation-dev", "binding": "BACKUP_VALIDATION", "class_name": "BackupValidationWorkflow" }
  ],
  "env": {
    "development": {
      "name": "lythaus-jobs-development",
      "workers_dev": false,
      "preview_urls": false,
      "ai": { "binding": "AI" },
      "routes": [],
      "hyperdrive": [
        { "binding": "DB_JOBS_FRESH", "id": "442bb04b99004cb38c6974ec031d65ee" },
        { "binding": "DB_PRIVACY_FRESH", "id": "bae909aa72e244bfa9b8ca8a948053b6" }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "HYPERDRIVE_QUERY_CACHE_MODE": "disabled",
        "AUTHENTICITY_AI_ENABLED": "true",
        "AUTHENTICITY_SHADOW_MODE": "true",
        "AUTHENTICITY_ENFORCEMENT_ENABLED": "false",
        "AUTHENTICITY_TEXT_MODEL": "@cf/openai/gpt-oss-20b",
        "AUTHENTICITY_IMAGE_MODEL": "@cf/openai/gpt-oss-20b",
        "R2_ACCOUNT_ID": "e5b7ae46e04698f507b7e4b3d4ef1af0",
        "MEDIA_PROCESSING_ENABLED": "false",
        "MEDIA_QUARANTINE_BUCKET": "lythaus-media-quarantine-dev",
        "MEDIA_APPROVED_BUCKET": "lythaus-media-approved-dev",
        "EXTERNAL_BACKUP_HEALTHCHECK_URL": "",
        "EXPECTED_DATABASE_TARGET": "development",
        "EXPECTED_DATABASE_SCHEMA_FINGERPRINT": "8922ea383a1a9ff32b9b695e3b04bf5f56648d6a7371d8a35b49db7fae394ad8",
        "EXPECTED_DATABASE_RELATION_COUNT": "77",
        "EXPECTED_DATABASE_SCHEMA_VERSION": "unknown",
        "EXPECTED_DATABASE_ROLE_CLASS": "login_non_superuser",
        "COST_BUDGET_ENABLED": "true",
        "COST_BUDGET_LIMIT_USD": "10",
        "COST_BUDGET_WARNING_USD": "5",
        "COST_BUDGET_OPTIONAL_ANALYSIS_USD": "7",
        "COST_BUDGET_ESSENTIAL_ONLY_USD": "8",
        "COST_BUDGET_DEEP_SCAN_STOP_USD": "9",
        "COST_AUTHENTICITY_TEXT_ESTIMATE_USD": "0.004",
        "COST_AUTHENTICITY_IMAGE_ESTIMATE_USD": "0.01",
        "AI_GATEWAY_ID": "lythaus-ai"
      },
      "r2_buckets": [
        { "binding": "MEDIA_QUARANTINE", "bucket_name": "lythaus-media-quarantine-dev" },
        { "binding": "MEDIA_APPROVED", "bucket_name": "lythaus-media-approved-dev" },
        { "binding": "PRIVATE_EXPORTS", "bucket_name": "lythaus-private-exports-dev" },
        { "binding": "AUDIT_ARCHIVE", "bucket_name": "lythaus-audit-archive-dev" }
      ],
      "kv_namespaces": [{ "binding": "LYTHAUS_CONFIG", "id": "b02289a521bd40bd9112335a3e763b11" }],
      "queues": {
        "producers": [
          { "binding": "MODERATION_QUEUE", "queue": "lythaus-moderation-dev" },
          { "binding": "FEED_QUEUE", "queue": "lythaus-feed-dev" },
          { "binding": "NOTIFICATIONS_QUEUE", "queue": "lythaus-notifications-dev" },
          { "binding": "MEDIA_QUEUE", "queue": "lythaus-media-dev" },
          { "binding": "PRIVACY_QUEUE", "queue": "lythaus-privacy-dev" },
          { "binding": "AUDIT_QUEUE", "queue": "lythaus-audit-dev" }
        ],
        "consumers": [
          { "queue": "lythaus-moderation-dev", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-moderation-dlq-dev" },
          { "queue": "lythaus-feed-dev", "max_batch_size": 25, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-feed-dlq-dev" },
          { "queue": "lythaus-notifications-dev", "max_batch_size": 25, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-notifications-dlq-dev" },
          { "queue": "lythaus-media-dev", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-media-dlq-dev" },
          { "queue": "lythaus-privacy-dev", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-privacy-dlq-dev" },
          { "queue": "lythaus-audit-dev", "max_batch_size": 25, "max_batch_timeout": 5, "max_retries": 10, "dead_letter_queue": "lythaus-audit-dlq-dev" }
        ]
      },
      "workflows": [
        { "name": "lythaus-account-delete-dev", "binding": "ACCOUNT_DELETE", "class_name": "AccountDeleteWorkflow" },
        { "name": "lythaus-account-export-dev", "binding": "ACCOUNT_EXPORT", "class_name": "AccountExportWorkflow" },
        { "name": "lythaus-retention-cleanup-dev", "binding": "RETENTION_CLEANUP", "class_name": "RetentionCleanupWorkflow" },
        { "name": "lythaus-appeal-lifecycle-dev", "binding": "APPEAL_LIFECYCLE", "class_name": "AppealLifecycleWorkflow" },
        { "name": "lythaus-backup-validation-dev", "binding": "BACKUP_VALIDATION", "class_name": "BackupValidationWorkflow" }
      ]
    }
  }
}
