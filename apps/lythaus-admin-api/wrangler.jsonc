{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lythaus-admin-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.25 },
  "vars": {
    "ENVIRONMENT": "production",
    "EXPECTED_HOSTNAMES": "admin-api.lythaus.co",
    "CORS_ALLOWED_ORIGINS": "https://admin.lythaus.co",
    "HYPERDRIVE_QUERY_CACHE_MODE": "disabled",
    "EXPECTED_DATABASE_TARGET": "main",
    "EXPECTED_DATABASE_SCHEMA_FINGERPRINT": "86ff272e09dbd195f18d262c354449ececdb907663615786c90a0d630b8f8625",
    "EXPECTED_DATABASE_RELATION_COUNT": "78",
    "EXPECTED_DATABASE_SCHEMA_VERSION": "0008_legacy_relink_status.sql",
    "EXPECTED_DATABASE_ROLE_CLASS": "login_non_superuser",
    "EXPECTED_DATABASE_BUDGET_LEDGER_APPLIED": "false",
    "AUTHENTICATED_ACCEPTANCE_PROVEN": "false"
  },
  "hyperdrive": [
    { "binding": "DB_ADMIN_FRESH", "id": "6bfbb0eab42642e8ad294dbf59294ed3" },
    { "binding": "DB_PRIVACY_FRESH", "id": "bae909aa72e244bfa9b8ca8a948053b6" }
  ],
  "r2_buckets": [
    { "binding": "PRIVATE_EXPORTS", "bucket_name": "lythaus-private-exports-dev" },
    { "binding": "AUDIT_ARCHIVE", "bucket_name": "lythaus-audit-archive-dev" }
  ],
  "env": {
    "development": {
      "name": "lythaus-admin-api-development",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "hyperdrive": [
        { "binding": "DB_ADMIN_FRESH", "id": "6bfbb0eab42642e8ad294dbf59294ed3" },
        { "binding": "DB_PRIVACY_FRESH", "id": "bae909aa72e244bfa9b8ca8a948053b6" }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "EXPECTED_HOSTNAMES": "lythaus-admin-api-development.asora.workers.dev",
        "CORS_ALLOWED_ORIGINS": "http://localhost:3000",
        "HYPERDRIVE_QUERY_CACHE_MODE": "disabled",
        "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_ACCESS_TEAM_DOMAIN",
        "ACCESS_AUDIENCE": "REPLACE_WITH_ACCESS_AUDIENCE",
        "ACCESS_JWKS_URL": "REPLACE_WITH_ACCESS_JWKS_URL",
        "EXPECTED_DATABASE_TARGET": "development",
        "EXPECTED_DATABASE_SCHEMA_FINGERPRINT": "8922ea383a1a9ff32b9b695e3b04bf5f56648d6a7371d8a35b49db7fae394ad8",
        "EXPECTED_DATABASE_RELATION_COUNT": "77",
        "EXPECTED_DATABASE_SCHEMA_VERSION": "unknown",
        "EXPECTED_DATABASE_ROLE_CLASS": "login_non_superuser"
      },
      "r2_buckets": [
        { "binding": "PRIVATE_EXPORTS", "bucket_name": "lythaus-private-exports-dev" },
        { "binding": "AUDIT_ARCHIVE", "bucket_name": "lythaus-audit-archive-dev" }
      ]
    }
  }
}
