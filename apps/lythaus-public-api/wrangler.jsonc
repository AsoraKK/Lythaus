{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lythaus-public-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "ENVIRONMENT": "production",
    "EXPECTED_HOSTNAMES": "api.lythaus.co",
    "CORS_ALLOWED_ORIGINS": "https://lythaus.co,https://www.lythaus.co,https://app.lythaus.co",
    "HYPERDRIVE_QUERY_CACHE_MODE": "disabled",
    "R2_ACCOUNT_ID": "e5b7ae46e04698f507b7e4b3d4ef1af0",
    "MEDIA_QUOTA_BYTES": "1073741824",
    "MEDIA_UPLOADS_ENABLED": "false",
    "MEDIA_QUARANTINE_BUCKET": "lythaus-media-quarantine-dev",
    "MEDIA_APPROVED_BUCKET": "lythaus-media-approved-dev",
    "EMAIL_PROVIDER_MODE": "cloudflare",
    "EMAIL_FROM": "no-reply@mail.lythaus.co",
    "EMAIL_VERIFICATION_BASE_URL": "https://lythaus.co/verify-email?token=",
    "EMAIL_PASSWORD_RESET_BASE_URL": "https://lythaus.co/reset-password?token=",
    "TURNSTILE_REQUIRED": "true",
    "TURNSTILE_EXPECTED_HOSTNAMES": "lythaus.co,www.lythaus.co,admin.lythaus.co",
    "PASSWORD_HASH_ALLOW_SCRYPT_FALLBACK": "false",
    "EXPECTED_DATABASE_TARGET": "main",
    "EXPECTED_DATABASE_SCHEMA_FINGERPRINT": "REPLACE_WITH_POST_0016_SCHEMA_FINGERPRINT",
    "EXPECTED_DATABASE_RELATION_COUNT": "REPLACE_WITH_POST_0016_RELATION_COUNT",
    "EXPECTED_DATABASE_SCHEMA_VERSION": "0016_transactional_email_envelope_boundary.sql",
    "EXPECTED_DATABASE_ROLE_CLASS": "login_non_superuser",
    "EXPECTED_DATABASE_BUDGET_LEDGER_APPLIED": "true",
    "AUTHENTICATED_ACCEPTANCE_PROVEN": "false"
  },
  "hyperdrive": [
    { "binding": "DB_APP_FRESH", "id": "3e59f07db51345aa896333ca861d1adf" }
  ],
  "services": [
    { "binding": "JOBS_COMPATIBILITY", "service": "lythaus-jobs-development" }
  ],
  "kv_namespaces": [
    { "binding": "LYTHAUS_CONFIG", "id": "b02289a521bd40bd9112335a3e763b11" }
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@mail.lythaus.co"] }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_QUARANTINE", "bucket_name": "lythaus-media-quarantine-dev" },
    { "binding": "MEDIA_APPROVED", "bucket_name": "lythaus-media-approved-dev" },
    { "binding": "PRIVATE_EXPORTS", "bucket_name": "lythaus-private-exports-dev" }
  ],
  "queues": {
    "producers": [
      { "binding": "MODERATION_QUEUE", "queue": "lythaus-moderation-dev" },
      { "binding": "FEED_QUEUE", "queue": "lythaus-feed-dev" },
      { "binding": "PRIVACY_QUEUE", "queue": "lythaus-privacy-dev" }
    ]
  },
  "env": {
    "development": {
      "name": "lythaus-public-api-development",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "hyperdrive": [{ "binding": "DB_APP_FRESH", "id": "3e59f07db51345aa896333ca861d1adf" }],
      "vars": {
        "ENVIRONMENT": "development",
        "EXPECTED_HOSTNAMES": "lythaus-public-api-development.lythaus.workers.dev",
        "R2_ACCOUNT_ID": "e5b7ae46e04698f507b7e4b3d4ef1af0",
        "MEDIA_QUOTA_BYTES": "1073741824",
        "MEDIA_QUARANTINE_BUCKET": "lythaus-media-quarantine-dev",
        "MEDIA_APPROVED_BUCKET": "lythaus-media-approved-dev",
        "MEDIA_UPLOADS_ENABLED": "false",
        "EMAIL_PROVIDER_URL": "http://localhost:8788/email",
        "EMAIL_PROVIDER_MODE": "fallback",
        "EMAIL_FROM": "no-reply@localhost",
        "EMAIL_VERIFICATION_BASE_URL": "http://localhost:4321/verify-email?token=",
        "EMAIL_PASSWORD_RESET_BASE_URL": "http://localhost:4321/reset-password?token=",
        "TURNSTILE_REQUIRED": "false",
        "TURNSTILE_EXPECTED_HOSTNAMES": "localhost,127.0.0.1",
        "PASSWORD_HASH_ALLOW_SCRYPT_FALLBACK": "true",
        "CORS_ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:4321",
        "HYPERDRIVE_QUERY_CACHE_MODE": "disabled",
        "EXPECTED_DATABASE_TARGET": "development",
        "EXPECTED_DATABASE_SCHEMA_FINGERPRINT": "8922ea383a1a9ff32b9b695e3b04bf5f56648d6a7371d8a35b49db7fae394ad8",
        "EXPECTED_DATABASE_RELATION_COUNT": "77",
        "EXPECTED_DATABASE_SCHEMA_VERSION": "unknown",
        "EXPECTED_DATABASE_ROLE_CLASS": "login_non_superuser"
      },
      "kv_namespaces": [{ "binding": "LYTHAUS_CONFIG", "id": "b02289a521bd40bd9112335a3e763b11" }],
      "r2_buckets": [
        { "binding": "MEDIA_QUARANTINE", "bucket_name": "lythaus-media-quarantine-dev" },
        { "binding": "MEDIA_APPROVED", "bucket_name": "lythaus-media-approved-dev" },
        { "binding": "PRIVATE_EXPORTS", "bucket_name": "lythaus-private-exports-dev" }
      ],
      "queues": {
        "producers": [
          { "binding": "MODERATION_QUEUE", "queue": "lythaus-moderation-dev" },
          { "binding": "FEED_QUEUE", "queue": "lythaus-feed-dev" },
          { "binding": "PRIVACY_QUEUE", "queue": "lythaus-privacy-dev" }
        ]
      }
    }
  }
}
