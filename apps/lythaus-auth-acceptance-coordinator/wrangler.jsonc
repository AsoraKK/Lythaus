{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lythaus-auth-acceptance-coordinator-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "observability": { "enabled": true, "head_sampling_rate": 0.25 },
  "routes": [
    { "pattern": "admin.lythaus.co/api/admin/production-auth-acceptance/*", "zone_name": "lythaus.co" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_ACCEPTANCE_PUBLIC_API_URL": "https://api.lythaus.co",
    "AUTH_ACCEPTANCE_ROUTE_BASE_URL": "https://admin.lythaus.co",
    "AUTH_ACCEPTANCE_TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY",
    "HYPERDRIVE_QUERY_CACHE_MODE": "disabled",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUDIENCES": "REPLACE_WITH_ADMIN_UI_ACCESS_AUDIENCE,REPLACE_WITH_ADMIN_API_ACCESS_AUDIENCE",
    "ACCESS_JWKS_URL": "REPLACE_WITH_ACCESS_JWKS_URL",
    "EXPECTED_DATABASE_TARGET": "main",
    "EXPECTED_DATABASE_SCHEMA_FINGERPRINT": "REPLACE_WITH_POST_0015_SCHEMA_FINGERPRINT",
    "EXPECTED_DATABASE_RELATION_COUNT": "REPLACE_WITH_POST_0015_RELATION_COUNT",
    "EXPECTED_DATABASE_SCHEMA_VERSION": "0016_transactional_email_envelope_boundary.sql",
    "EXPECTED_DATABASE_ROLE_CLASS": "login_non_superuser",
    "EXPECTED_DATABASE_BUDGET_LEDGER_APPLIED": "true",
    "AUTHENTICATED_ACCEPTANCE_PROVEN": "false"
  },
  "hyperdrive": [
    { "binding": "DB_ADMIN_FRESH", "id": "6bfbb0eab42642e8ad294dbf59294ed3" }
  ]
}
