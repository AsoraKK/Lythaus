---
import BaseLayout from '../layouts/BaseLayout.astro';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const emailPrefill = Astro.url.searchParams.get('email')?.trim() ?? '';
---

<BaseLayout
  title="Reset your password"
  description="Request a secure Lythaus password reset link."
  canonicalPath="/forgot-password"
>
  <section class="auth-page" aria-labelledby="reset-request-title">
    <div class="auth-intro">
      <span class="pill">Lythaus account</span>
      <h1 id="reset-request-title">Reset your password.</h1>
      <p>Enter your email address and we will send a one-time reset link if the account is eligible.</p>
    </div>

    <form
      class="auth-form"
      data-password-reset-request-form
      data-api-base-url={publicApiBaseUrl}
      data-turnstile-site-key={turnstileSiteKey}
      novalidate
    >
      <label for="reset-email">Email address</label>
      <input id="reset-email" name="email" type="email" autocomplete="email" maxlength="320" value={emailPrefill} required />

      <div class="auth-turnstile-shell" id="reset-turnstile" role="group" aria-label="Bot verification"></div>
      <button class="button primary" type="submit" data-reset-submit>Send reset link</button>
      <p class="auth-status" data-reset-status aria-live="polite" role="status"></p>
      <p class="auth-footnote">Remembered your password? <a href="https://app.lythaus.co/login">Sign in to Lythaus</a>.</p>
    </form>
  </section>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  <script is:inline>
    const form = document.querySelector('[data-password-reset-request-form]');
    if (form instanceof HTMLFormElement) {
      const email = form.querySelector('#reset-email');
      const button = form.querySelector('[data-reset-submit]');
      const status = form.querySelector('[data-reset-status]');
      const turnstileContainer = form.querySelector('#reset-turnstile');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      const siteKey = form.dataset.turnstileSiteKey ?? '';
      let widgetId;
      let tokenResolve;
      let tokenReject;

      const setStatus = (message, state = 'idle') => {
        if (status instanceof HTMLElement) {
          status.textContent = message;
          status.dataset.state = state;
        }
      };
      const resetVerification = () => {
        tokenReject?.(new Error('turnstile_failed'));
        tokenResolve = undefined;
        tokenReject = undefined;
        if (widgetId !== undefined && window.turnstile) window.turnstile.reset(widgetId);
      };
      const renderTurnstile = () => {
        if (!window.turnstile || !turnstileContainer || !siteKey || widgetId !== undefined) return false;
        widgetId = window.turnstile.render(turnstileContainer, {
          sitekey: siteKey,
          action: 'password_reset_request',
          appearance: 'interaction-only',
          execution: 'execute',
          callback: (value) => {
            tokenResolve?.(value);
            tokenResolve = undefined;
            tokenReject = undefined;
          },
          'expired-callback': resetVerification,
          'error-callback': resetVerification,
        });
        return true;
      };
      let attempts = 0;
      const renderTimer = window.setInterval(() => {
        attempts += 1;
        if (renderTurnstile() || attempts >= 100) window.clearInterval(renderTimer);
      }, 100);
      const requestToken = async () => {
        const rendered = widgetId !== undefined || renderTurnstile();
        if (!siteKey || !rendered || widgetId === undefined || !window.turnstile) throw new Error('turnstile_unavailable');
        return new Promise((resolve, reject) => {
          tokenResolve = resolve;
          tokenReject = reject;
          window.turnstile.execute(widgetId);
        });
      };
      const messageFor = (code) => {
        if (code === 'invalid_email') return 'Enter a valid email address.';
        if (code === 'rate_limit_exceeded') return 'Too many requests. Please wait and try again.';
        if (code === 'turnstile_failed' || code === 'turnstile_required' || code === 'turnstile_unavailable') return 'We could not verify this request. Please try again.';
        if (code === 'email_delivery_not_configured' || /^email_delivery_failed(?:_[1-5][0-9]{2})?$/u.test(code)) return 'We could not send the reset email. Please try again later.';
        return 'We could not start password recovery. Please try again.';
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(email instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
        if (!email.validity.valid) {
          email.reportValidity();
          setStatus('Enter a valid email address.', 'error');
          return;
        }
        button.disabled = true;
        button.textContent = 'Sending...';
        setStatus('', 'submitting');
        try {
          const turnstileToken = await requestToken();
          const response = await fetch(`${apiBaseUrl}/api/auth/password/reset/request`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: email.value, turnstileToken }),
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(typeof body.error === 'string' ? body.error : 'password_reset_request_failed');
          setStatus('If an account is eligible, a reset email is on its way.', 'success');
        } catch (error) {
          setStatus(messageFor(error instanceof Error ? error.message : 'password_reset_request_failed'), 'error');
        } finally {
          resetVerification();
          button.disabled = false;
          button.textContent = 'Send reset link';
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .auth-page { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.7fr); gap: clamp(48px, 10vw, 140px); align-items: start; padding: clamp(82px, 13vw, 150px) 0 120px; }
  .auth-intro h1 { margin-top: 22px; }
  .auth-intro p { max-width: 520px; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .auth-form { display: grid; gap: 10px; padding: 30px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .auth-form label { color: var(--muted); font-size: 13px; }
  .auth-form input { width: 100%; min-height: 50px; padding: 0 15px; color: var(--text); background: #0d0f10; border: 1px solid var(--line-strong); border-radius: 10px; outline: none; }
  .auth-form input:focus { border-color: rgba(223,231,220,.7); box-shadow: 0 0 0 3px rgba(223,231,220,.08); }
  .auth-footnote { margin: 0 0 8px; color: var(--quiet); font-size: 12px; line-height: 1.5; }
  .auth-turnstile-shell { min-height: 65px; margin: 8px 0; }
  .auth-status { min-height: 24px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .auth-status[data-state='error'] { color: #f1a7a0; }
  .auth-status[data-state='success'] { color: #b8d5b5; }
  @media (max-width: 760px) { .auth-page { grid-template-columns: 1fr; padding-top: 72px; } .auth-form { padding: 22px; } }
</style>
