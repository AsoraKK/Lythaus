---
import BaseLayout from '../layouts/BaseLayout.astro';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
---

<BaseLayout
  title="Choose a new password"
  description="Choose a new Lythaus account password."
  canonicalPath="/reset-password"
  noReferrer
  noIndex
>
  <section class="auth-page" aria-labelledby="reset-complete-title">
    <div class="auth-intro">
      <span class="pill">Lythaus account</span>
      <h1 id="reset-complete-title">Choose a new password.</h1>
      <p>Use a strong password you do not reuse elsewhere. This link can be used once and expires shortly.</p>
    </div>

    <form
      class="auth-form"
      data-password-reset-complete-form
      data-api-base-url={publicApiBaseUrl}
      novalidate
    >
      <label for="new-password">New password</label>
      <input id="new-password" name="password" type="password" autocomplete="new-password" minlength="15" maxlength="128" aria-describedby="new-password-note" required />
      <p class="auth-field-note" id="new-password-note">Use at least 15 characters, up to 128. Longer passphrases are welcome. Password managers, paste, and autofill are supported.</p>

      <label for="new-password-confirmation">Confirm new password</label>
      <input id="new-password-confirmation" name="passwordConfirmation" type="password" autocomplete="new-password" minlength="15" maxlength="128" aria-describedby="new-password-note" required />

      <button class="button primary" type="submit" data-reset-submit>Set new password</button>
      <p class="auth-status" data-reset-status aria-live="polite" aria-atomic="true" role="status" tabindex="-1"></p>
      <p class="auth-footnote"><a href="/sign-in">Return to Lythaus sign in</a>.</p>
    </form>
  </section>

  <script is:inline>
    const form = document.querySelector('[data-password-reset-complete-form]');
    if (form instanceof HTMLFormElement) {
      const password = form.querySelector('#new-password');
      const confirmation = form.querySelector('#new-password-confirmation');
      const button = form.querySelector('[data-reset-submit]');
      const status = form.querySelector('[data-reset-status]');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      let token = new URL(window.location.href).searchParams.get('token')?.trim() ?? '';
      let isSubmitting = false;
      let completed = false;

      const setStatus = (message, state = 'idle', moveFocus = true) => {
        if (status instanceof HTMLElement) {
          status.textContent = message;
          status.dataset.state = state;
          if (moveFocus && message) status.focus();
        }
      };
      const messageFor = (code) => {
        if (code === 'reset_token_invalid') return 'This reset link is invalid or expired. Request a new one.';
        if (code === 'invalid_password') return 'Use a password between 15 and 128 characters.';
        return 'We could not change your password. Request a new reset link and try again.';
      };

      window.history.replaceState(null, '', '/reset-password');
      if (!token) {
        setStatus('This reset link is missing or invalid. Request a new one.', 'error');
        if (button instanceof HTMLButtonElement) button.disabled = true;
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (isSubmitting || !(password instanceof HTMLInputElement) || !(confirmation instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement) || !token) return;
        if (!password.validity.valid || password.value !== confirmation.value) {
          password.setAttribute('aria-invalid', 'true');
          confirmation.setAttribute('aria-invalid', 'true');
          setStatus('Passwords must match and contain at least 15 characters.', 'error');
          return;
        }
        password.removeAttribute('aria-invalid');
        confirmation.removeAttribute('aria-invalid');
        isSubmitting = true;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Updating...';
        setStatus('', 'submitting');
        try {
          const response = await fetch(`${apiBaseUrl}/api/auth/password/reset/complete`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token, password: password.value }),
            cache: 'no-store',
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok || body.state !== 'password_reset_completed') throw new Error(typeof body.error === 'string' ? body.error : 'password_reset_failed');
          token = '';
          completed = true;
          password.value = '';
          confirmation.value = '';
          password.disabled = true;
          confirmation.disabled = true;
          button.disabled = true;
          button.textContent = 'Password updated';
          setStatus('Your password has been changed and existing sessions were signed out. Sign in again in the Lythaus app.', 'success');
          window.history.replaceState(null, '', '/reset-password');
        } catch (error) {
          setStatus(messageFor(error instanceof Error ? error.message : 'password_reset_failed'), 'error');
        }
        button.setAttribute('aria-busy', 'false');
        if (!completed) {
          button.disabled = false;
          button.textContent = 'Set new password';
        }
        isSubmitting = false;
      });
    }
  </script>
</BaseLayout>

<style>
  .auth-page { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.7fr); gap: clamp(48px, 10vw, 140px); align-items: start; padding: clamp(82px, 13vw, 150px) 0 120px; }
  .auth-intro h1 { margin-top: 22px; }
  .auth-intro p { max-width: 520px; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .auth-form { display: grid; gap: 10px; padding: 30px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .auth-form label { color: var(--muted); font-size: 13px; }
  .auth-form input { width: 100%; min-height: 50px; padding: 0 15px; color: var(--text); background: #0d0f10; border: 1px solid var(--line-strong); border-radius: 10px; outline: none; }
  .auth-form input:focus { border-color: rgba(223,231,220,.7); box-shadow: 0 0 0 3px rgba(223,231,220,.08); }
  .auth-form input[aria-invalid='true'] { border-color: #f1a7a0; }
  .auth-field-note, .auth-footnote { margin: 0 0 8px; color: var(--quiet); font-size: 12px; line-height: 1.5; }
  .auth-status { min-height: 24px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .auth-status:focus { outline: 2px solid var(--accent); outline-offset: 4px; }
  .auth-status[data-state='error'] { color: #f1a7a0; }
  .auth-status[data-state='success'] { color: #b8d5b5; }
  @media (max-width: 760px) { .auth-page { grid-template-columns: 1fr; padding-top: 72px; } .auth-form { padding: 22px; } }
</style>
