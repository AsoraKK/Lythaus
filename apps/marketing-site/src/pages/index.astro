---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpeningWordmark from '../components/OpeningWordmark.astro';
import '../styles/home-pitch.css';
import '../styles/home-pitch-compact.css';
import '../styles/home-polish.css';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<BaseLayout
  title="For the living internet"
  description="Human ideas. Conversations worth having. Lythaus is building a social platform for original perspectives, thoughtful discussion and meaningful contributions."
  canonicalPath="/"
  absoluteTitle={true}
  homePage={true}
>
  <section class="pitch-intro" id="top" aria-labelledby="pitch-wordmark">
    <div class="pitch-intro-inner">
      <OpeningWordmark />
      <p class="pitch-intro-statement">Human ideas. Conversations worth having.</p>
      <div class="pitch-intro-support">
        <div class="pitch-lede">
          <p>For the living internet.</p>
          <p>We’re building a social platform where people share original perspectives, discover thoughtful discussion, and earn recognition through meaningful contributions.</p>
        </div>
        <a class="button primary" href="#waitlist">Join the waitlist</a>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-platform" id="platform" aria-labelledby="platform-title">
    <span id="problem"></span><span id="public-interest"></span>
    <div class="pitch-section-meta">01 / PERSPECTIVE</div>
    <div class="pitch-platform-grid">
      <div>
        <h2 id="platform-title">Share your perspective.</h2>
        <p class="pitch-lede">Your experience can give someone else a new way to see things.</p>
      </div>
      <div class="pitch-story-copy">
        <p>Bring your experience, research, creative work and useful questions. Make room for thoughtful discussion, good sourcing and good-faith disagreement.</p>
        <p>Lythaus is being built for people who want to contribute something of their own and learn from what others share.</p>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-discovery" id="discovery" aria-labelledby="discovery-title">
    <div class="pitch-section-meta">02 / CONVERSATION</div>
    <div class="pitch-discovery-grid">
      <div>
        <h2 id="discovery-title">Find conversations worth joining.</h2>
        <p class="pitch-lede">Different ways to explore, with choices you can understand.</p>
        <p>We’re building around these feed choices. Availability will depend on the rollout.</p>
      </div>
      <div>
        <ul class="pitch-clean-list" aria-label="Feed choices">
          <li><strong>Discovery:</strong> explore eligible public posts, newest first.</li>
          <li><strong>Following:</strong> catch up with people you follow.</li>
          <li><strong>Custom feeds:</strong> choose filters to focus on the conversations that interest you.</li>
        </ul>
        <p><a href="/features">Explore the features</a></p>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-reputation pitch-section--compact" id="reputation" aria-labelledby="reputation-title">
    <span id="editorial"></span>
    <div class="pitch-section-meta">03 / RECOGNITION &amp; REWARDS</div>
    <h2 id="reputation-title">Build reputation through contribution.</h2>
    <div class="pitch-reputation-grid">
      <div>
        <p class="pitch-lede">Recognition should grow from what you contribute.</p>
        <p>Our reputation model values constructive human-authored contributions, useful sources and accountable participation.</p>
      </div>
      <div class="pitch-reputation-copy">
        <p>Rewards are part of that ambition. We’re developing ways to recognise sustained contributions; reward availability and eligibility will be explained as they roll out.</p>
        <p>Paid membership does not buy reputation, Editorial recognition or different moderation treatment.</p>
        <p><a href="/pricing">Free to join. Benefits from $5.</a></p>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-human-first" id="authorship" aria-labelledby="authorship-title">
    <span id="human-first"></span><span id="accountability"></span><span id="why-lythaus"></span>
    <div class="pitch-section-meta">04 / TRUST</div>
    <h2 id="authorship-title">Understand how trust works.</h2>
    <div class="pitch-story-copy pitch-story-copy--narrow">
      <p>Authorship tells you how a contribution was made. Safety moderation addresses harmful content. Both matter, and they serve different purposes.</p>
      <p>Our authorship policy uses simple labels:</p>
    </div>
    <dl class="pitch-authorship-list">
      <div>
        <dt>Human-authored</dt>
        <dd>A person’s original contribution.</dd>
      </div>
      <div>
        <dt>AI-assisted</dt>
        <dd>Disclosed, human-led text with permitted AI assistance, limited to 249 characters.</dd>
      </div>
      <div>
        <dt>Under review</dt>
        <dd>An authorship decision needs further review.</dd>
      </div>
    </dl>
    <div class="pitch-story-copy pitch-story-copy--narrow">
      <p>AI-generated content is not permitted for public publication. Spellcheck, grammar help, formatting and transcription of your own speech are not penalised solely for their use.</p>
      <p>We’re developing automated authorship signals to support trained human review. These signals do not establish whether content is safe or true.</p>
      <p>During alpha, authorised staff review appeals under our <a href="/terms">Terms</a>. The planned trained-reviewer and adjudicator process is subject to rollout readiness; it is not an open community vote.</p>
      <p>Your privacy comes first. Unauthorised scraping and harvesting of personal data are prohibited.</p>
      <p><a href="/about">Read more about our principles</a></p>
    </div>
  </section>

  <section class="home-waitlist pitch-waitlist" id="waitlist" aria-labelledby="waitlist-title">
    <div class="home-waitlist-copy">
      <p class="home-eyebrow"><span class="home-status-dot" aria-hidden="true"></span>Lythaus waitlist</p>
      <h2 id="waitlist-title">For the living internet.</h2>
      <div class="pitch-story-copy">
        <p>Join the waitlist for updates as we build Lythaus.</p>
        <p>Joining does not guarantee an invitation or an access date.</p>
      </div>
    </div>
    <form class="home-waitlist-form" data-waitlist data-api-base-url={publicApiBaseUrl} data-turnstile-site-key={turnstileSiteKey} novalidate>
      <label class="sr-only" for="waitlist-email">Email address</label>
      <div class="home-waitlist-fields">
        <input id="waitlist-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="320" placeholder="Email address" aria-describedby="waitlist-consent waitlist-status" required />
        <button class="button primary" type="submit" data-waitlist-submit>Join the waitlist</button>
      </div>
      <div class="home-turnstile-shell" id="waitlist-turnstile" role="group" aria-label="Bot verification"></div>
      <p class="home-consent-note" id="waitlist-consent">By joining, you agree to receive waitlist and launch updates from Lythaus. You can unsubscribe at any time. Read our <a href="/privacy">Privacy Policy</a>.</p>
      <div class="home-waitlist-success" data-waitlist-success hidden>
        <h3>You're on the list.</h3>
        <p>Thanks for joining Lythaus. We'll be in touch when there is something worth sharing.</p>
      </div>
      <p class="home-form-status" id="waitlist-status" data-waitlist-status aria-live="polite" role="status">We do not promise access timing.</p>
    </form>
    <p class="pitch-waitlist-signoff">Human authorship. Accountable participation. Discovery you can understand.</p>
  </section>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  <script>
    const form = document.querySelector('[data-waitlist]');
    if (form instanceof HTMLFormElement) {
      const input = form.querySelector('input[name="email"]');
      const button = form.querySelector('[data-waitlist-submit]');
      const status = form.querySelector('[data-waitlist-status]');
      const success = form.querySelector('[data-waitlist-success]');
      const widgetContainer = form.querySelector('#waitlist-turnstile');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      const siteKey = form.dataset.turnstileSiteKey ?? '';
      let widgetId: string | undefined;
      let tokenResolve: ((value: string) => void) | undefined;
      let tokenReject: ((reason: Error) => void) | undefined;

      const setStatus = (message: string, state = 'idle') => {
        if (!status) return;
        status.textContent = message;
        status.dataset.state = state;
      };

      const rejectPendingToken = () => {
        tokenReject?.(new Error('turnstile_failed'));
        tokenResolve = undefined;
        tokenReject = undefined;
      };

      const resetVerification = () => {
        rejectPendingToken();
        if (widgetId !== undefined && window.turnstile) window.turnstile.reset(widgetId);
      };

      const handleVerificationFailure = () => {
        resetVerification();
      };

      const renderTurnstile = () => {
        if (!window.turnstile || !widgetContainer || !siteKey || widgetId !== undefined) return false;
        widgetId = window.turnstile.render(widgetContainer, {
          sitekey: siteKey,
          action: 'waitlist_signup',
          appearance: 'interaction-only',
          execution: 'execute',
          callback: (value) => {
            tokenResolve?.(value);
            tokenResolve = undefined;
            tokenReject = undefined;
          },
          'expired-callback': handleVerificationFailure,
          'error-callback': handleVerificationFailure,
        });
        return true;
      };

      let renderAttempts = 0;
      const renderTimer = window.setInterval(() => {
        renderAttempts += 1;
        if (renderTurnstile() || renderAttempts >= 100) window.clearInterval(renderTimer);
      }, 100);

      const requestToken = async () => {
        const rendered = widgetId !== undefined || renderTurnstile();
        if (!siteKey || !rendered || widgetId === undefined || !window.turnstile) throw new Error('turnstile_unavailable');
        return new Promise<string>((resolve, reject) => {
          tokenResolve = resolve;
          tokenReject = reject;
          window.turnstile?.execute(widgetId);
        });
      };

      const errorMessage = (code: string) => {
        if (code === 'invalid_email') return 'Enter a valid email address.';
        if (code === 'turnstile_failed' || code === 'turnstile_required' || code === 'turnstile_unavailable') return "We couldn't verify this request. Please try again.";
        if (code === 'rate_limit_exceeded') return 'Too many attempts. Please try again shortly.';
        return "We couldn't add you right now. Please try again in a moment.";
      };

      const successMessage = "You're on the list. Thanks for joining Lythaus. We'll be in touch when there is something worth sharing.";

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
        if (!input.validity.valid) {
          input.reportValidity();
          setStatus('Enter a valid email address.', 'error');
          return;
        }
        button.disabled = true;
        button.textContent = 'Joining...';
        setStatus('', 'submitting');
        try {
          const turnstileToken = await requestToken();
          const response = await fetch(`${apiBaseUrl}/api/waitlist`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: input.value, turnstileToken, consentVersion: 'waitlist-v1', source: 'lythaus.co' }),
          });
          const payload = await response.json().catch(() => ({})) as { error?: unknown };
          if (!response.ok) throw new Error(typeof payload.error === 'string' ? payload.error : 'waitlist_unavailable');
          form.reset();
          form.dataset.state = 'success';
          if (success instanceof HTMLElement) success.hidden = false;
          setStatus(successMessage, 'success');
        } catch (error) {
          const code = error instanceof Error ? error.message : 'waitlist_unavailable';
          setStatus(errorMessage(code), 'error');
        } finally {
          resetVerification();
          button.disabled = false;
          button.textContent = 'Join the waitlist';
        }
      });
    }
  </script>
</BaseLayout>
