---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-pitch.css';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<BaseLayout
  title="Lythaus | Human-first public-interest platform"
  description="Lythaus is a human-first, public-interest platform built for genuine human interaction, transparent Discovery and accountable human contribution."
  canonicalPath="/"
  absoluteTitle={true}
  homePage={true}
>
  <section class="pitch-intro" id="top" aria-labelledby="pitch-wordmark">
    <div class="pitch-intro-inner">
      <p class="pitch-intro-meta">00 / Opening</p>
      <h1 class="pitch-wordmark" id="pitch-wordmark" aria-label="Lythaus">
        <span class="pitch-letter" style="--letter-index: 0; --letter-delay: 90ms" aria-hidden="true">L</span>
        <span class="pitch-letter" style="--letter-index: 1; --letter-delay: 225ms" aria-hidden="true">Y</span>
        <span class="pitch-letter" style="--letter-index: 2; --letter-delay: 360ms" aria-hidden="true">T</span>
        <span class="pitch-letter" style="--letter-index: 3; --letter-delay: 495ms" aria-hidden="true">H</span>
        <span class="pitch-letter" style="--letter-index: 4; --letter-delay: 630ms" aria-hidden="true">A</span>
        <span class="pitch-letter" style="--letter-index: 5; --letter-delay: 765ms" aria-hidden="true">U</span>
        <span class="pitch-letter" style="--letter-index: 6; --letter-delay: 900ms" aria-hidden="true">S</span>
      </h1>
      <p class="pitch-intro-statement">The human internet is worth protecting.</p>
    </div>
    <a class="pitch-scroll-cue" href="#problem" aria-label="Continue to the problem section"><span></span></a>
  </section>

  <section class="pitch-section pitch-problem" id="problem" aria-labelledby="problem-title" data-pitch-reveal>
    <div class="pitch-section-meta">01 / The Problem</div>
    <div class="pitch-problem-grid">
      <div class="pitch-copy-column">
        <h2 id="problem-title">The internet has changed.</h2>
        <p class="pitch-lede">Content can now be generated at extraordinary scale due to AI.</p>
        <p>At the same time, existing social media platforms increasingly reward volume, virality and engagement, creating an environment where these can thrive.</p>
      </div>
      <div>
        <ul class="pitch-signal-list" aria-label="Problems affecting modern social platforms">
          <li>AI-generated slop.</li>
          <li>Bot accounts manipulating feeds.</li>
          <li>Ragebait headlines.</li>
          <li>Engagement farming.</li>
          <li>Manufactured attention.</li>
        </ul>
        <p class="pitch-result">The result is more noise, greater manipulation and growing uncertainty about what or who is real.</p>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-human-first" id="human-first" aria-labelledby="human-first-title" data-pitch-reveal>
    <div class="pitch-section-meta">02 / Built for Humans First</div>
    <h2 id="human-first-title">Built for humans first.</h2>
    <div class="pitch-four-lines" aria-label="Lythaus priorities">
      <span>Human interaction.</span>
      <span>Public-interest information.</span>
      <span>Accountable contribution.</span>
      <span>Clearer context.</span>
    </div>
    <p class="pitch-welcome">Welcome to Lythaus.</p>
  </section>

  <section class="pitch-section pitch-platform" id="lythaus" aria-labelledby="lythaus-title" data-pitch-reveal>
    <div class="pitch-section-meta">03 / What Lythaus Is</div>
    <div class="pitch-platform-grid">
      <div>
        <h2 id="lythaus-title">Lythaus is a human-first, public-interest platform built for genuine human interaction.</h2>
        <p class="pitch-lede">Follow people and topics. Share your perspective. Discuss what matters. Discover public-interest information from other humans.</p>
      </div>
      <div class="pitch-platform-detail">
        <h3>Lythaus is different.</h3>
        <p>Lythaus Authenticity AI actively detects and blocks AI-generated public content, while behavioural signals help identify bot activity, coordinated abuse and manipulation.</p>
        <p>Our Discovery feed uses simple, transparent algorithms based on interests you choose, your optional general location, previous searches and other signals you control.</p>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-experience" id="experience" aria-labelledby="experience-title" data-pitch-reveal>
    <div class="pitch-section-meta">04 / Experience Lythaus</div>
    <div class="pitch-experience-grid">
      <div class="pitch-copy-column">
        <h2 id="experience-title">Preview how Lythaus works.</h2>
        <p class="pitch-lede">A lightweight, illustrative view of Discovery, authorship disclosure and member controls.</p>
        <p>See how the product makes human contribution, context and accountability visible without pretending this preview is a live guest app.</p>
        <p class="pitch-quiet">Illustrative UI only. No account actions or live content are available here.</p>
      </div>
      <div class="pitch-preview-shell" data-preview aria-label="Illustrative Lythaus product preview" role="region">
        <div class="pitch-preview-topbar">
          <span>Illustrative product preview</span>
          <span>Preview only</span>
        </div>
        <div class="pitch-preview-body">
          <div class="pitch-preview-tabs" role="tablist" aria-label="Preview states">
            <button type="button" role="tab" id="preview-tab-discovery" aria-selected="true" aria-controls="preview-panel-discovery" data-preview-tab="discovery">Discovery</button>
            <button type="button" role="tab" id="preview-tab-authorship" aria-selected="false" aria-controls="preview-panel-authorship" data-preview-tab="authorship">Authorship</button>
            <button type="button" role="tab" id="preview-tab-controls" aria-selected="false" aria-controls="preview-panel-controls" data-preview-tab="controls">Controls</button>
          </div>
          <div class="pitch-preview-panels">
            <section class="pitch-preview-panel" id="preview-panel-discovery" role="tabpanel" aria-labelledby="preview-tab-discovery" data-preview-panel="discovery">
              <p class="pitch-preview-panel-label">Illustrative contribution</p>
              <article class="pitch-preview-post">
                <div class="pitch-preview-post-head">
                  <span class="pitch-avatar" aria-hidden="true"></span>
                  <div>
                    <strong>A human contribution</strong>
                    <small>Human-authored</small>
                  </div>
                </div>
                <p>A considered contribution with context around the topic, the person sharing it and the signals that help others understand what they are seeing.</p>
                <div class="pitch-preview-post-meta">
                  <span>Public-interest discussion</span>
                  <strong>Contribution + accountability</strong>
                </div>
              </article>
            </section>
            <section class="pitch-preview-panel" id="preview-panel-authorship" role="tabpanel" aria-labelledby="preview-tab-authorship" data-preview-panel="authorship">
              <p class="pitch-preview-panel-label">Clear authorship context</p>
              <article class="pitch-preview-state">
                <div><strong>AI-assisted</strong><span>Disclosed at contribution</span></div>
                <p>When AI assists a public contribution, the context stays visible instead of being presented as something it is not.</p>
              </article>
              <article class="pitch-preview-state is-review">
                <div><strong>Under review</strong><span>Separate explanatory state</span></div>
                <p>Unclear or conflicting authorship information can remain under review. AI-generated public content is not shown as published.</p>
              </article>
            </section>
            <section class="pitch-preview-panel" id="preview-panel-controls" role="tabpanel" aria-labelledby="preview-tab-controls" data-preview-panel="controls">
              <p class="pitch-preview-panel-label">Transparent feed controls</p>
              <div class="pitch-preview-controls" aria-label="Illustrative member-controlled Discovery inputs">
                <button type="button" data-preview-control aria-pressed="true"><span>Your chosen interests</span><strong>Included</strong></button>
                <button type="button" data-preview-control aria-pressed="false"><span>Optional general location</span><strong>Off</strong></button>
                <button type="button" data-preview-control aria-pressed="true"><span>Your feed preferences</span><strong>Included</strong></button>
              </div>
              <p class="pitch-preview-control-status" data-preview-control-status aria-live="polite">Preview controls only. No feed request is made.</p>
            </section>
          </div>
        </div>
        <div class="pitch-preview-footer">
          <div>
            <strong>Product proof without a live-app claim.</strong>
            <span>Want to help shape what comes next?</span>
          </div>
          <a class="button primary" href="#waitlist">Join Lythaus early</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-discovery" id="discovery" aria-labelledby="discovery-title" data-pitch-reveal>
    <div class="pitch-section-meta">05 / A Different Kind of Feed</div>
    <div class="pitch-discovery-grid">
      <div>
        <h2 id="discovery-title">Algorithms for relevance, not addiction.</h2>
        <p class="pitch-lede">Personalisation itself is not the problem.</p>
        <p>The question is what it is optimised for.</p>
      </div>
      <div>
        <p class="pitch-small-heading">Lythaus Discovery can consider</p>
        <ul class="pitch-clean-list">
          <li>Your chosen interests</li>
          <li>General location, optional, or a region of your choice</li>
          <li>Previous searches</li>
          <li>Topics you follow</li>
          <li>Your feed preferences</li>
          <li>Reputation and contribution signals</li>
        </ul>
      </div>
    </div>
    <div class="pitch-control-line">
      <strong>Your interests. Your controls. Your feed.</strong>
      <span>Members can see and manage the information shaping Discovery.</span>
    </div>
    <div class="pitch-discovery-controls" aria-label="Illustrative Discovery controls">
      <div><span>Chosen interests</span><strong>Selected by you</strong><em>Editable</em></div>
      <div><span>General location</span><strong>Optional by design</strong><em>Editable</em></div>
      <div><span>Feed preferences</span><strong>Managed by you</strong><em>Editable</em></div>
    </div>
    <div class="pitch-no-profile">
      <h3>No hidden behavioural profile built simply to keep you scrolling.</h3>
      <p>Personalisation is designed to be transparent, editable and under the member's control.</p>
    </div>
  </section>

  <section class="pitch-section pitch-reputation" id="reputation" aria-labelledby="reputation-title" data-pitch-reveal>
    <div class="pitch-section-meta">06 / Reputation</div>
    <p class="pitch-pretitle">Attention is easy to manufacture.</p>
    <h2 id="reputation-title">Reputation is earned.</h2>
    <div class="pitch-reputation-grid">
      <div>
        <p>Lythaus reputation is designed around contribution and accountability rather than:</p>
        <ul class="pitch-reputation-rejects">
          <li>Follower count.</li>
          <li>Posting volume.</li>
          <li>Virality.</li>
          <li>Paid visibility.</li>
          <li>Engagement manipulation.</li>
        </ul>
      </div>
      <div class="pitch-reputation-copy">
        <p>Qualifying human-authored contributions can build authorship reputation.</p>
        <p>Deliberate mislabelling, manipulation, evasion and coordinated abuse can reduce standing.</p>
        <div class="pitch-reputation-signal" aria-label="Illustrative reputation signal">
          <span>Reputation signal</span>
          <strong>Contribution + accountability</strong>
          <small>Not follower count or virality.</small>
        </div>
        <strong>Who contributes should matter. How they contribute should matter more.</strong>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-ai" id="ai" aria-labelledby="ai-title" data-pitch-reveal>
    <div class="pitch-section-meta">07 / Lythaus and AI</div>
    <div class="pitch-ai-grid">
      <div>
        <h2 id="ai-title">Lythaus is not anti-AI.</h2>
        <p class="pitch-lede">AI helped us design and build Lythaus, and it will remain an important part of our lives.</p>
      </div>
      <div class="pitch-ai-copy">
        <p>The distinction is not whether AI should exist, but how and where it should participate.</p>
        <p>Lythaus prioritises human authorship and human accountability in public-interest discussion.</p>
        <p class="pitch-emphasis">Technology should assist human participation, not impersonate or quietly replace it.</p>
        <p class="pitch-data-promise">Member content is not sold or repurposed to train generative models.</p>
      </div>
    </div>
  </section>

  <section class="pitch-section pitch-principles" id="principles" aria-labelledby="principles-title" data-pitch-reveal>
    <div class="pitch-section-meta">08 / Principles</div>
    <h2 id="principles-title" class="sr-only">Lythaus principles</h2>
    <ol class="pitch-principle-list">
      <li>Human interaction should remain human.</li>
      <li>Technology should assist people, not impersonate them.</li>
      <li>Public-interest conversation deserves better incentives.</li>
      <li>People should understand why they see what they see.</li>
    </ol>
  </section>

  <section class="home-waitlist pitch-waitlist" id="waitlist" aria-labelledby="waitlist-title" data-pitch-reveal>
    <div class="home-waitlist-copy">
      <p class="home-eyebrow"><span class="home-status-dot" aria-hidden="true"></span>Lythaus private beta</p>
      <h2 id="waitlist-title">Join Lythaus early.</h2>
      <p>Join the Lythaus waitlist for early access, product updates and an opportunity to help shape what comes next.</p>
    </div>
    <form class="home-waitlist-form" data-waitlist data-api-base-url={publicApiBaseUrl} data-turnstile-site-key={turnstileSiteKey} novalidate>
      <label class="sr-only" for="waitlist-email">Email address</label>
      <div class="home-waitlist-fields">
        <input id="waitlist-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="320" placeholder="Email address" aria-describedby="waitlist-consent waitlist-status" required />
        <button class="button primary" type="submit" data-waitlist-submit>Join the waitlist</button>
      </div>
      <div class="home-turnstile-shell" id="waitlist-turnstile" role="group" aria-label="Bot verification"></div>
      <p class="home-consent-note" id="waitlist-consent">By joining, you agree to receive waitlist and launch updates from Lythaus. You can unsubscribe at any time. Read our <a href="/privacy">Privacy Policy</a>.</p>
      <div class="home-waitlist-success" data-waitlist-success hidden>
        <h3>You're on the list.</h3>
        <p>Thanks for joining Lythaus. We'll be in touch when there is something worth sharing.</p>
      </div>
      <p class="home-form-status" id="waitlist-status" data-waitlist-status aria-live="polite" role="status"></p>
    </form>
  </section>

  <script>
    (() => {
      const revealTargets = Array.from(document.querySelectorAll('[data-pitch-reveal]'));
      const preview = document.querySelector('[data-preview]');
      const previewTabs = Array.from(document.querySelectorAll('[data-preview-tab]'));
      const previewPanels = Array.from(document.querySelectorAll('[data-preview-panel]'));
      const previewControls = Array.from(document.querySelectorAll('[data-preview-control]'));
      const previewControlStatus = document.querySelector('[data-preview-control-status]');

      const activatePreview = (name, moveFocus = false) => {
        previewTabs.forEach((tab) => {
          const active = tab.getAttribute('data-preview-tab') === name;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          if (moveFocus && active) tab.focus();
        });
        previewPanels.forEach((panel) => {
          const active = panel.getAttribute('data-preview-panel') === name;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
      };

      if (preview instanceof HTMLElement && previewTabs.length && previewPanels.length) {
        preview.dataset.previewEnhanced = 'true';
        activatePreview('discovery');
        previewTabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activatePreview(tab.getAttribute('data-preview-tab') ?? 'discovery'));
          tab.addEventListener('keydown', (event) => {
            if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            const nextIndex = event.key === 'Home'
              ? 0
              : event.key === 'End'
                ? previewTabs.length - 1
                : (index + (event.key === 'ArrowRight' ? 1 : -1) + previewTabs.length) % previewTabs.length;
            const nextTab = previewTabs[nextIndex];
            activatePreview(nextTab.getAttribute('data-preview-tab') ?? 'discovery', true);
          });
        });
      }

      previewControls.forEach((control) => {
        control.addEventListener('click', () => {
          const active = control.getAttribute('aria-pressed') !== 'true';
          control.setAttribute('aria-pressed', String(active));
          const state = control.querySelector('strong');
          if (state) state.textContent = active ? 'Included' : 'Off';
          if (previewControlStatus) previewControlStatus.textContent = 'Preview controls only. No feed request is made.';
        });
      });

      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        revealTargets.forEach((target) => target.classList.add('pitch-reveal-pending'));
        const revealObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealTargets.forEach((target) => revealObserver.observe(target));
      }

      const resolveOpening = () => document.documentElement.classList.add('pitch-opening-resolved');
      ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach((eventName) => {
        window.addEventListener(eventName, resolveOpening, { once: true, passive: eventName !== 'keydown' });
      });
      window.setTimeout(resolveOpening, 1800);
    })();
  </script>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  <script>
    const form = document.querySelector('[data-waitlist]');
    if (form instanceof HTMLFormElement) {
      const input = form.querySelector('input[name="email"]');
      const button = form.querySelector('[data-waitlist-submit]');
      const status = form.querySelector('[data-waitlist-status]');
      const success = form.querySelector('[data-waitlist-success]');
      const widgetContainer = form.querySelector('#waitlist-turnstile');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      const siteKey = form.dataset.turnstileSiteKey ?? '';
      let widgetId: string | undefined;
      let tokenResolve: ((value: string) => void) | undefined;
      let tokenReject: ((reason: Error) => void) | undefined;

      const setStatus = (message: string, state = 'idle') => {
        if (!status) return;
        status.textContent = message;
        status.dataset.state = state;
      };

      const rejectPendingToken = () => {
        tokenReject?.(new Error('turnstile_failed'));
        tokenResolve = undefined;
        tokenReject = undefined;
      };

      const resetVerification = () => {
        rejectPendingToken();
        if (widgetId !== undefined && window.turnstile) window.turnstile.reset(widgetId);
      };

      const handleVerificationFailure = () => {
        resetVerification();
      };

      const renderTurnstile = () => {
        if (!window.turnstile || !widgetContainer || !siteKey || widgetId !== undefined) return false;
        widgetId = window.turnstile.render(widgetContainer, {
          sitekey: siteKey,
          action: 'waitlist_signup',
          appearance: 'interaction-only',
          execution: 'execute',
          callback: (value) => {
            tokenResolve?.(value);
            tokenResolve = undefined;
            tokenReject = undefined;
          },
          'expired-callback': handleVerificationFailure,
          'error-callback': handleVerificationFailure,
        });
        return true;
      };

      let renderAttempts = 0;
      const renderTimer = window.setInterval(() => {
        renderAttempts += 1;
        if (renderTurnstile() || renderAttempts >= 100) window.clearInterval(renderTimer);
      }, 100);

      const requestToken = async () => {
        const rendered = widgetId !== undefined || renderTurnstile();
        if (!siteKey || !rendered || widgetId === undefined || !window.turnstile) throw new Error('turnstile_unavailable');
        return new Promise<string>((resolve, reject) => {
          tokenResolve = resolve;
          tokenReject = reject;
          window.turnstile?.execute(widgetId);
        });
      };

      const errorMessage = (code: string) => {
        if (code === 'invalid_email') return 'Enter a valid email address.';
        if (code === 'turnstile_failed' || code === 'turnstile_required' || code === 'turnstile_unavailable') return "We couldn't verify this request. Please try again.";
        if (code === 'rate_limit_exceeded') return 'Too many attempts. Please try again shortly.';
        return "We couldn't add you right now. Please try again in a moment.";
      };

      const successMessage = "You're on the list. Thanks for joining Lythaus. We'll be in touch when there is something worth sharing.";

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
        if (!input.validity.valid) {
          input.reportValidity();
          setStatus('Enter a valid email address.', 'error');
          return;
        }
        button.disabled = true;
        button.textContent = 'Joining...';
        setStatus('', 'submitting');
        try {
          const turnstileToken = await requestToken();
          const response = await fetch(`${apiBaseUrl}/api/waitlist`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: input.value, turnstileToken, consentVersion: 'waitlist-v1', source: 'lythaus.co' }),
          });
          const payload = await response.json().catch(() => ({})) as { error?: unknown };
          if (!response.ok) throw new Error(typeof payload.error === 'string' ? payload.error : 'waitlist_unavailable');
          form.reset();
          form.dataset.state = 'success';
          if (success instanceof HTMLElement) success.hidden = false;
          setStatus(successMessage, 'success');
        } catch (error) {
          const code = error instanceof Error ? error.message : 'waitlist_unavailable';
          setStatus(errorMessage(code), 'error');
        } finally {
          resetVerification();
          button.disabled = false;
          button.textContent = 'Join the waitlist';
        }
      });
    }
  </script>
</BaseLayout>
