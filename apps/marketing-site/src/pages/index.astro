---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-pitch.css';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<BaseLayout
  title="For the living internet"
  description="Lythaus is a human-first social platform for public-interest conversation, built around clear authorship, accountable participation and feeds you can understand and control."
  canonicalPath="/"
  absoluteTitle={true}
  homePage={true}
>
  <section class="hero hero--story" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="eyebrow">Lythaus</span>
      <h1 id="hero-title">For the living internet.</h1>
      <p class="hero-lede">
        Lythaus is a human-first social platform for public-interest conversation,
        built around clear authorship, accountable participation and feeds you can
        understand and control.
      </p>
      <a class="button primary" href="#waitlist">Join the private beta</a>
    </div>
    <div class="hero-card hero-card--signal" aria-hidden="true">
      <span class="signal-mark">✦</span>
      <p>Human authorship.<br />Accountable participation.<br />Discovery you can understand.</p>
    </div>
  </section>

  <section class="story-section" id="problem" aria-labelledby="problem-title">
    <p class="section-kicker">01 / THE PROBLEM</p>
    <h2 id="problem-title">We are losing sight of who is speaking and what is real.</h2>
    <div class="story-columns">
      <p>The internet has made it easier than ever to publish, connect and participate.</p>
      <p>It has also become harder to know what is genuine.</p>
    </div>
    <p>
      AI-generated content can be produced at enormous scale. Bots imitate participation.
      Engagement systems reward outrage. Spam competes with original thought. Algorithms
      decide what reaches us, often without explaining why.
    </p>
    <p>
      The result is not simply more content. It is less certainty about who made it, why it
      reached you and whether the person behind it is willing to stand behind what they said.
    </p>
    <p class="story-callout">Lythaus is being built around a different set of incentives.</p>
  </section>

  <section class="story-section story-section--tint" id="human-first" aria-labelledby="human-first-title">
    <p class="section-kicker">02 / HUMAN FIRST</p>
    <h2 id="human-first-title">Built for humans.</h2>
    <div class="story-copy">
      <p>Lythaus is not anti-AI.</p>
      <p>AI can be useful. We use it ourselves.</p>
      <p>The distinction that matters is between assistance and substitution.</p>
      <p>
        Public conversation carries more meaning when authorship is clear, contribution has
        accountability and people can distinguish human expression from synthetic generation.
      </p>
      <p>That principle shapes how Lythaus approaches publishing, reputation and discovery.</p>
    </div>
    <div class="label-grid" aria-label="Authorship labels">
      <article class="label-card">
        <span class="label-card__tag">Human-authored</span>
        <p>Original human contribution.</p>
      </article>
      <article class="label-card">
        <span class="label-card__tag">AI-assisted</span>
        <p>Limited, disclosed assistance where permitted by Lythaus policy.</p>
      </article>
      <article class="label-card">
        <span class="label-card__tag">AI-generated</span>
        <p>Not permitted as public content. Blocked from public publication.</p>
      </article>
      <article class="label-card">
        <span class="label-card__tag">Under review</span>
        <p>Used when an authorship decision requires further review.</p>
      </article>
    </div>
    <p class="story-callout">No public confidence scores. No false precision.<br />Just clearer authorship.</p>
  </section>

  <section class="story-section" id="platform" aria-labelledby="platform-title">
    <p class="section-kicker">03 / THE PLATFORM</p>
    <h2 id="platform-title">A place for information that matters.</h2>
    <p>
      Lythaus is a social platform for people who want more signal and less manipulation in
      the way they discover and discuss the world.
    </p>
    <div class="feature-grid">
      <p>Follow people and subjects you care about.</p>
      <p>Share reporting, analysis, experience, questions and perspective.</p>
      <p>Discover conversations across technology, science, business, culture, policy, local affairs, current events and more.</p>
      <p>And have meaningful control over what shapes your feed.</p>
    </div>
    <p class="story-callout">The ambition is not to create the loudest public square.<br />It is to create a more trustworthy one.</p>
  </section>

  <section class="story-section story-section--tint" id="authorship" aria-labelledby="authorship-title">
    <p class="section-kicker">04 / AUTHORSHIP</p>
    <h2 id="authorship-title">Authorship should mean something.</h2>
    <div class="story-copy">
      <p>AI-generated public content isn't permitted on Lythaus.</p>
      <p>
        To support that policy, we are building a layered authenticity system that can consider
        declarations, provenance, specialist classifiers and behavioural signals.
      </p>
      <p>No single model is treated as an infallible judge of authorship.</p>
      <p>Where AI assistance is permitted, it should be disclosed clearly.</p>
      <p>Where content is assessed as human-authored, that contribution should be recognisable as such.</p>
      <p>And where the system is uncertain, it should be able to say so.</p>
    </div>
    <p class="story-callout">Clear authorship. Not manufactured certainty.</p>
  </section>

  <section class="story-section" id="discovery" aria-labelledby="discovery-title">
    <p class="section-kicker">05 / DISCOVERY</p>
    <h2 id="discovery-title">Your feed should not be a black box.</h2>
    <p>Most social platforms decide what deserves your attention for you.</p>
    <p>Lythaus is being designed so that discovery is more understandable and more deliberate.</p>
    <p>
      Your feeds can reflect the people and subjects you choose to follow, while reputation and
      contribution quality help surface worthwhile discussion.
    </p>
    <div class="not-list" aria-label="What Lythaus discovery is not">
      <p>Not simply what generates the most reactions.</p>
      <p>Not whatever keeps you scrolling longest.</p>
      <p>Not outrage because outrage performs well.</p>
    </div>
    <p class="story-callout">The objective is straightforward:<br />help useful human contributions travel further.</p>
  </section>

  <section class="story-section story-section--tint" id="reputation" aria-labelledby="reputation-title">
    <p class="section-kicker">06 / REPUTATION</p>
    <h2 id="reputation-title">Contribution over attention.</h2>
    <p>
      On Lythaus, reputation is intended to reflect how you contribute, not simply how much
      attention you can attract.
    </p>
    <div class="feature-grid feature-grid--compact">
      <p>Human-authored contributions can build authorship reputation.</p>
      <p>Consistent participation matters.</p>
      <p>Good sourcing matters.</p>
      <p>Accountability matters.</p>
    </div>
    <p>
      Honest disclosure of permitted AI assistance does not automatically count against you,
      but it does not earn authorship reputation for work you did not author yourself.
    </p>
    <p class="story-callout">Virality alone is not credibility.<br />Followers alone are not reputation.<br />And volume is not the same as value.</p>
  </section>

  <section class="story-section" id="accountability" aria-labelledby="accountability-title">
    <p class="section-kicker">07 / ACCOUNTABILITY</p>
    <h2 id="accountability-title">Accountability has to work both ways.</h2>
    <div class="story-copy">
      <p>Lythaus will make decisions about authorship, moderation and participation.</p>
      <p>Those decisions will sometimes be challenged.</p>
      <p>They may sometimes be wrong.</p>
      <p>
        That is why review and appeal are part of the system, with decisions assessed by peers
        rather than treated as an afterthought.
      </p>
      <p>
        Authorship and moderation decisions are designed to have understandable reasons,
        durable records and routes for review.
      </p>
      <p>
        Community reviewers can contribute to appeals, with additional adjudication for cases
        that require it.
      </p>
      <p>No person, status or paid tier is intended to be above the rules.</p>
    </div>
    <p class="story-callout">If Lythaus expects accountability from its members, members should be able to expect accountability from Lythaus.</p>
  </section>

  <section class="story-section story-section--tint" id="public-interest" aria-labelledby="public-interest-title">
    <p class="section-kicker">08 / PUBLIC INTEREST</p>
    <h2 id="public-interest-title">Not everything valuable goes viral.</h2>
    <p>Lythaus is being built for conversations whose importance cannot always be measured in clicks.</p>
    <div class="feature-grid">
      <p>Original reporting.</p>
      <p>Local knowledge.</p>
      <p>Scientific discussion.</p>
      <p>Analysis.</p>
      <p>First-hand experience.</p>
      <p>Good-faith disagreement.</p>
      <p>Questions worth exploring.</p>
      <p>Ideas that require more than a reaction button.</p>
    </div>
    <p>
      Public-interest conversation does not have to mean institutional or political conversation.
      It means information and perspective that can be useful beyond the person posting it.
    </p>
  </section>

  <section class="story-section" id="editorial" aria-labelledby="editorial-title">
    <p class="section-kicker">09 / EDITORIAL</p>
    <h2 id="editorial-title">Credibility should be earned, not purchased.</h2>
    <div class="story-copy">
      <p>
        Lythaus Editorial is intended for journalists, researchers, analysts, academics,
        independent writers and other contributors doing credible public-interest work.
      </p>
      <p>It is not a paid tier.</p>
      <p>It does not grant moderation immunity.</p>
      <p>It does not make someone an authority over what is true.</p>
      <p>Editorial recognition is earned, reviewable and revocable.</p>
      <p>
        Its purpose is to help people find and recognise credible work more easily, while giving
        contributors a way to build trust through consistent, transparent and accountable participation.
      </p>
      <p>
        It can help valuable reporting, research and analysis reach the audiences most likely to
        benefit from it, without reducing credibility to popularity or payment.
      </p>
      <p>The people behind that work remain accountable to the same platform standards as everyone else.</p>
    </div>
  </section>

  <section class="story-section story-section--tint" id="why-lythaus" aria-labelledby="why-title">
    <p class="section-kicker">10 / WHY LYTHAUS</p>
    <h2 id="why-title">A different set of incentives.</h2>
    <div class="story-copy">
      <p>We are not trying to maximise how angry you become.</p>
      <p>We are not trying to fill every empty space with content.</p>
      <p>We are not trying to make synthetic participation indistinguishable from human participation.</p>
      <p>And we are not trying to decide what you should believe.</p>
    </div>
    <p>
      We are building infrastructure for something simpler and increasingly valuable: people
      speaking for themselves, contributing with accountability and finding information without
      surrendering all control over how it reaches them.
    </p>
  </section>

  <section class="final-cta" id="waitlist" aria-labelledby="cta-title">
    <p class="section-kicker">FOR THE LIVING INTERNET</p>
    <h2 id="cta-title">For the living internet.</h2>
    <div class="story-copy">
      <p>Not because everything humans make is good.</p>
      <p>Not because technology is the enemy.</p>
      <p>
        Because knowing that another person chose to say something, and is willing to stand
        behind it, still matters.
      </p>
      <p>Lythaus is being built for that.</p>
    </div>
    <form class="waitlist-form waitlist-form--inline" data-waitlist data-api-base-url={publicApiBaseUrl} data-turnstile-site-key={turnstileSiteKey} novalidate>
      <label class="sr-only" for="waitlist-email">Email address</label>
          <div class="waitlist-fields">
            <input id="waitlist-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="320" placeholder="Email address" aria-describedby="waitlist-consent waitlist-status" required />
            <button class="button primary" type="submit" data-waitlist-submit>Join the private beta</button>
          </div>
          <div class="turnstile-shell" id="waitlist-turnstile" role="group" aria-label="Bot verification"></div>
          <p class="form-note" id="waitlist-consent">By joining, you agree to receive waitlist and launch updates from Lythaus. You can unsubscribe at any time. Read our <a href="/privacy">Privacy Policy</a>.</p>
          <div class="waitlist-success" data-waitlist-success hidden>
            <h3>You're on the list.</h3>
            <p>Thanks for joining Lythaus. We'll be in touch when there is something worth sharing.</p>
          </div>
          <p class="form-note" id="waitlist-status" data-waitlist-status aria-live="polite" role="status">We do not promise access timing.</p>
    </form>
    <p class="cta-signoff">Human authorship.<br />Accountable participation.<br />Discovery you can understand.</p>
  </section>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  <script>
    const form = document.querySelector('[data-waitlist]');
    if (form instanceof HTMLFormElement) {
      const input = form.querySelector('input[name="email"]');
      const button = form.querySelector('[data-waitlist-submit]');
      const status = form.querySelector('[data-waitlist-status]');
      const success = form.querySelector('[data-waitlist-success]');
      const widgetContainer = form.querySelector('#waitlist-turnstile');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      const siteKey = form.dataset.turnstileSiteKey ?? '';
      let widgetId: string | undefined;
      let tokenResolve: ((value: string) => void) | undefined;
      let tokenReject: ((reason: Error) => void) | undefined;

      const setStatus = (message: string, state = 'idle') => {
        if (!status) return;
        status.textContent = message;
        status.dataset.state = state;
      };

      const rejectPendingToken = () => {
        tokenReject?.(new Error('turnstile_failed'));
        tokenResolve = undefined;
        tokenReject = undefined;
      };

      const resetVerification = () => {
        rejectPendingToken();
        if (widgetId !== undefined && window.turnstile) window.turnstile.reset(widgetId);
      };

      const handleVerificationFailure = () => {
        resetVerification();
      };

      const renderTurnstile = () => {
        if (!window.turnstile || !widgetContainer || !siteKey || widgetId !== undefined) return false;
        widgetId = window.turnstile.render(widgetContainer, {
          sitekey: siteKey,
          action: 'waitlist_signup',
          appearance: 'interaction-only',
          execution: 'execute',
          callback: (value) => {
            tokenResolve?.(value);
            tokenResolve = undefined;
            tokenReject = undefined;
          },
          'expired-callback': handleVerificationFailure,
          'error-callback': handleVerificationFailure,
        });
        return true;
      };

      let renderAttempts = 0;
      const renderTimer = window.setInterval(() => {
        renderAttempts += 1;
        if (renderTurnstile() || renderAttempts >= 100) window.clearInterval(renderTimer);
      }, 100);

      const requestToken = async () => {
        const rendered = widgetId !== undefined || renderTurnstile();
        if (!siteKey || !rendered || widgetId === undefined || !window.turnstile) throw new Error('turnstile_unavailable');
        return new Promise<string>((resolve, reject) => {
          tokenResolve = resolve;
          tokenReject = reject;
          window.turnstile?.execute(widgetId);
        });
      };

      const errorMessage = (code: string) => {
        if (code === 'invalid_email') return 'Enter a valid email address.';
        if (code === 'turnstile_failed' || code === 'turnstile_required' || code === 'turnstile_unavailable') return "We couldn't verify this request. Please try again.";
        if (code === 'rate_limit_exceeded') return 'Too many attempts. Please try again shortly.';
        return "We couldn't add you right now. Please try again in a moment.";
      };

      const successMessage = "You're on the list. Thanks for joining Lythaus. We'll be in touch when there is something worth sharing.";

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
        if (!input.validity.valid) {
          input.reportValidity();
          setStatus('Enter a valid email address.', 'error');
          return;
        }
        button.disabled = true;
        button.textContent = 'Joining...';
        setStatus('', 'submitting');
        try {
          const turnstileToken = await requestToken();
          const response = await fetch(`${apiBaseUrl}/api/waitlist`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: input.value, turnstileToken, consentVersion: 'waitlist-v1', source: 'lythaus.co' }),
          });
          const payload = await response.json().catch(() => ({})) as { error?: unknown };
          if (!response.ok) throw new Error(typeof payload.error === 'string' ? payload.error : 'waitlist_unavailable');
          form.reset();
          form.dataset.state = 'success';
          if (success instanceof HTMLElement) success.hidden = false;
          setStatus(successMessage, 'success');
        } catch (error) {
          const code = error instanceof Error ? error.message : 'waitlist_unavailable';
          setStatus(errorMessage(code), 'error');
        } finally {
          resetVerification();
          button.disabled = false;
              button.textContent = 'Join the private beta';
        }
      });
    }
  </script>
</BaseLayout>
