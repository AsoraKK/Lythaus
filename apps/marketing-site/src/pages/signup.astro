---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<SecondaryLayout
  title="Create your account"
  description="Create a verified Lythaus account."
  canonicalPath="/signup"
>
  <section class="auth-page" aria-labelledby="signup-title">
    <div class="auth-intro">
      <span class="pill">Lythaus account</span>
      <h1 id="signup-title">Create your account.</h1>
      <p>Join Lythaus with a verified email address. We will send you a confirmation link before you enter the app.</p>
    </div>

    <form
      class="auth-form"
      data-signup-form
      data-api-base-url={publicApiBaseUrl}
      data-turnstile-site-key={turnstileSiteKey}
      novalidate
    >
      <label for="signup-email">Email address</label>
      <input id="signup-email" name="email" type="email" autocomplete="email" maxlength="320" required />

      <label for="signup-password">Password</label>
      <input id="signup-password" name="password" type="password" autocomplete="new-password" maxlength="256" aria-describedby="signup-password-note" required />
      <p class="auth-field-note" id="signup-password-note">Use at least 15 characters, up to 128. Longer passphrases are welcome. Password managers, paste, and autofill are supported.</p>

      <label for="signup-password-confirmation">Confirm password</label>
      <input id="signup-password-confirmation" name="passwordConfirmation" type="password" autocomplete="new-password" maxlength="256" aria-describedby="signup-password-note" required />

      <div class="auth-turnstile-shell" id="signup-turnstile" role="group" aria-label="Bot verification"></div>
      <button class="button primary" type="submit" data-signup-submit>Create account</button>
      <p class="auth-status" data-signup-status aria-live="polite" aria-atomic="true" role="status" tabindex="-1"></p>
      <button class="auth-resend" type="button" data-signup-resend hidden>Resend verification email</button>
      <p class="auth-field-note" id="signup-resend-cooldown" data-signup-resend-cooldown aria-live="polite"></p>
      <div class="auth-check-email" data-signup-check-email hidden aria-labelledby="signup-check-email-title">
        <h2 id="signup-check-email-title">Check your email</h2>
        <p>If the request was accepted, a verification message has been queued or is on its way. Delivery can take a few minutes and is not confirmed on this page.</p>
      </div>
      <p class="auth-footnote">Already have an account? <a href="/sign-in">Sign in to Lythaus</a>.</p>
    </form>
  </section>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  <script>
    import { authFetch, withAuthDeadline, acceptsPassword, transportErrorMessage } from '../scripts/auth-request';
    const form = document.querySelector('[data-signup-form]');
    if (form instanceof HTMLFormElement) {
      const email = form.querySelector('#signup-email');
      const password = form.querySelector('#signup-password');
      const confirmation = form.querySelector('#signup-password-confirmation');
      const button = form.querySelector('[data-signup-submit]');
      const status = form.querySelector('[data-signup-status]');
      const resendButton = form.querySelector('[data-signup-resend]');
      const checkEmailState = form.querySelector('[data-signup-check-email]');
      const turnstileContainer = form.querySelector('#signup-turnstile');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      const siteKey = form.dataset.turnstileSiteKey ?? '';
      let widgetId;
      let widgetAction = 'account_signup';
      let tokenResolve;
      let tokenReject;
      let isSubmitting = false;
      let cooldownUntil = 0;
      let cooldownTimer;

      const setStatus = (message, state = 'idle', moveFocus = true) => {
        if (status instanceof HTMLElement) {
          status.textContent = message;
          status.dataset.state = state;
          if (moveFocus && message) status.focus();
        }
      };
      const setResendVisible = (visible) => {
        if (resendButton instanceof HTMLButtonElement) resendButton.hidden = !visible;
      };
      const setCooldownMessage = () => {
        if (!(resendButton instanceof HTMLButtonElement)) return;
        const seconds = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
        resendButton.disabled = seconds > 0;
        resendButton.setAttribute('aria-describedby', seconds > 0 ? 'signup-resend-cooldown' : '');
        const cooldownMessage = form.querySelector('#signup-resend-cooldown');
        if (cooldownMessage instanceof HTMLElement) cooldownMessage.textContent = seconds > 0 ? `You can request another message in ${seconds} seconds.` : '';
        if (seconds <= 0 && cooldownTimer !== undefined) {
          window.clearInterval(cooldownTimer);
          cooldownTimer = undefined;
        }
      };
      const startCooldown = () => {
        cooldownUntil = Date.now() + 30_000;
        setCooldownMessage();
        cooldownTimer = window.setInterval(setCooldownMessage, 1000);
      };
      const resetVerification = () => {
        tokenReject?.(new Error('turnstile_failed'));
        tokenResolve = undefined;
        tokenReject = undefined;
        if (widgetId !== undefined && window.turnstile) window.turnstile.reset(widgetId);
      };
      const renderTurnstile = () => {
        if (!window.turnstile || !turnstileContainer || !siteKey || widgetId !== undefined) return false;
        widgetId = window.turnstile.render(turnstileContainer, {
          sitekey: siteKey,
          action: widgetAction,
          appearance: 'interaction-only',
          execution: 'execute',
          callback: (value) => {
            tokenResolve?.(value);
            tokenResolve = undefined;
            tokenReject = undefined;
          },
          'expired-callback': resetVerification,
          'error-callback': resetVerification,
        });
        return true;
      };
      let attempts = 0;
      const renderTimer = window.setInterval(() => {
        attempts += 1;
        if (renderTurnstile() || attempts >= 100) window.clearInterval(renderTimer);
      }, 100);
      const requestToken = async (action = 'account_signup') => {
        if (widgetAction !== action) {
          resetVerification();
          if (widgetId !== undefined && window.turnstile) window.turnstile.remove(widgetId);
          widgetId = undefined;
          widgetAction = action;
        }
        const rendered = widgetId !== undefined || renderTurnstile();
        if (!siteKey || !rendered || widgetId === undefined || !window.turnstile) throw new Error('turnstile_unavailable');
        return withAuthDeadline(new Promise((resolve, reject) => {
          tokenResolve = resolve;
          tokenReject = reject;
          window.turnstile.execute(widgetId);
        }));
      };
      const messageFor = (code) => {
        const transportMessage = transportErrorMessage(code);
        if (transportMessage) return transportMessage;
        if (code === 'account_exists') return 'We could not finish that request. If this was a retry, resend the verification email below.';
        if (code === 'email_verification_required') return 'Check your email and click the verification link before signing in.';
        if (code === 'invalid_email') return 'Enter a valid email address.';
        if (code === 'invalid_password') return 'Use a password between 15 and 128 characters.';
        if (code === 'rate_limit_exceeded') return 'Too many signup attempts. Please wait before trying again.';
        if (code === 'turnstile_failed' || code === 'turnstile_required' || code === 'turnstile_unavailable') return 'We could not verify this request. Please try again.';
        if (code === 'email_delivery_not_configured' || /^email_delivery_failed(?:_[1-5][0-9]{2})?$/u.test(code)) return 'Email delivery is temporarily delayed. Please try again shortly.';
        return 'We could not finish the signup request. If this was a retry, resend the verification email below.';
      };
      const shouldOfferResend = (code) => ![
        'invalid_email', 'invalid_password', 'rate_limit_exceeded',
        'turnstile_failed', 'turnstile_required', 'turnstile_unavailable',
      ].includes(code);
      const withSupportReference = (message, code, reference) => (
        reference && (code === 'request_failed' || code === 'account_creation_failed')
          ? `${message} Reference: ${reference}.`
          : message
      );

      const resendVerification = async () => {
        if (isSubmitting || !(email instanceof HTMLInputElement) || !(resendButton instanceof HTMLButtonElement)) return;
        if (!email.validity.valid) {
          email.setAttribute('aria-invalid', 'true');
          email.reportValidity();
          setStatus('Enter a valid email address.', 'error');
          return;
        }
        if (Date.now() < cooldownUntil) {
          setCooldownMessage();
          return;
        }
        isSubmitting = true;
        resendButton.disabled = true;
        resendButton.setAttribute('aria-busy', 'true');
        setStatus('Sending a new verification email...', 'submitting');
        try {
          const turnstileToken = await requestToken('verification_resend');
          const response = await authFetch(`${apiBaseUrl}/api/auth/email`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ mode: 'resend_verification', email: email.value, turnstileToken }),
            cache: 'no-store',
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok || body.state !== 'verification_required') throw new Error(typeof body.error === 'string' ? body.error : 'email_delivery_failed');
          startCooldown();
          setStatus('If this account is eligible, your verification request was accepted. Check your inbox; delivery is not confirmed yet.', 'success');
        } catch (error) {
          setStatus(messageFor(error instanceof Error ? error.message : 'email_delivery_failed'), 'error');
        } finally {
          resetVerification();
          resendButton.setAttribute('aria-busy', 'false');
          if (Date.now() >= cooldownUntil) resendButton.disabled = false;
          isSubmitting = false;
        }
      };

      resendButton?.addEventListener('click', resendVerification);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (isSubmitting || !(email instanceof HTMLInputElement) || !(password instanceof HTMLInputElement) || !(confirmation instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
        email.removeAttribute('aria-invalid');
        if (!email.validity.valid) {
          email.setAttribute('aria-invalid', 'true');
          email.reportValidity();
          setStatus('Enter a valid email address.', 'error');
          return;
        }
        if (!acceptsPassword(password.value, 'creation') || password.value !== confirmation.value) {
          password.setAttribute('aria-invalid', 'true');
          confirmation.setAttribute('aria-invalid', 'true');
          setStatus('Passwords must match and contain at least 15 characters.', 'error');
          return;
        }
        password.removeAttribute('aria-invalid');
        confirmation.removeAttribute('aria-invalid');
        isSubmitting = true;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Creating account...';
        setResendVisible(false);
        setStatus('', 'submitting');
        let failureReference = '';
        try {
          const turnstileToken = await requestToken();
          const response = await authFetch(`${apiBaseUrl}/api/auth/email`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ mode: 'register', email: email.value, password: password.value, turnstileToken }),
            cache: 'no-store',
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
          });
          const body = await response.json().catch(() => ({}));
          failureReference = typeof body.correlationId === 'string'
            ? body.correlationId
            : response.headers.get('x-correlation-id') ?? '';
          if (!response.ok || !['verification_required', 'check_email'].includes(body.state)) throw new Error(typeof body.error === 'string' ? body.error : 'account_creation_failed');
          password.value = '';
          confirmation.value = '';
          if (checkEmailState instanceof HTMLElement) checkEmailState.hidden = false;
          setResendVisible(true);
          setStatus('Your request was accepted. If eligible, check your email for the next step. If you already verified your account, sign in or use Forgot password. Delivery is not confirmed yet.', 'success');
        } catch (error) {
          const code = error instanceof Error ? error.message : 'account_creation_failed';
          setStatus(withSupportReference(messageFor(code), code, failureReference), 'error');
          setResendVisible(shouldOfferResend(code));
        } finally {
          resetVerification();
          button.disabled = false;
          button.setAttribute('aria-busy', 'false');
          button.textContent = 'Create account';
          isSubmitting = false;
        }
      });
    }
  </script>
</SecondaryLayout>
