---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';
---
<SecondaryLayout title="Page not found" description="This Lythaus page could not be found." canonicalPath="/404" noIndex>
  <section class="section" aria-labelledby="not-found-title">
    <span class="eyebrow">404 · Page not found</span>
    <h1 id="not-found-title">This page isn't here.</h1>
    <p>The link may have changed or the address may be incomplete.</p>
    <div class="auth-actions"><a class="button primary" href="/help">Find help</a><a class="text-link" href="/">Return to the homepage</a></div>
  </section>
</SecondaryLayout>
