---
import BaseLayout from '../layouts/BaseLayout.astro';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const emailPrefill = Astro.url.searchParams.get('email')?.trim() ?? '';
---

<BaseLayout
  title="Verify your email"
  description="Request a new Lythaus email verification link."
  canonicalPath="/resend-verification"
>
  <section class="auth-page" aria-labelledby="verification-title">
    <div class="auth-intro">
      <span class="pill">Lythaus account</span>
      <h1 id="verification-title">Verify your email.</h1>
      <p>Enter your email address and complete the check. If the account is waiting for verification, we will send a new one-time link.</p>
    </div>

    <form
      class="auth-form"
      data-verification-resend-form
      data-api-base-url={publicApiBaseUrl}
      data-turnstile-site-key={turnstileSiteKey}
      novalidate
    >
      <label for="verification-email">Email address</label>
      <input id="verification-email" name="email" type="email" autocomplete="email" maxlength="320" value={emailPrefill} aria-describedby="verification-email-note" required />
      <p class="auth-field-note" id="verification-email-note">We use the same response for every email address.</p>

      <div class="auth-turnstile-shell" id="verification-turnstile" role="group" aria-label="Bot verification"></div>
      <button class="button primary" type="submit" data-verification-submit>Resend verification email</button>
      <p class="auth-status" data-verification-status aria-live="polite" aria-atomic="true" role="status" tabindex="-1"></p>
      <p class="auth-field-note" data-verification-cooldown aria-live="polite"></p>
      <p class="auth-footnote">Already verified? <a href="/sign-in">Sign in to Lythaus</a>.</p>
    </form>
  </section>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  <script is:inline>
    const form = document.querySelector('[data-verification-resend-form]');
    if (form instanceof HTMLFormElement) {
      const email = form.querySelector('#verification-email');
      const button = form.querySelector('[data-verification-submit]');
      const status = form.querySelector('[data-verification-status]');
      const cooldown = form.querySelector('[data-verification-cooldown]');
      const turnstileContainer = form.querySelector('#verification-turnstile');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      const siteKey = form.dataset.turnstileSiteKey ?? '';
      let widgetId;
      let tokenResolve;
      let tokenReject;
      let isSubmitting = false;
      let cooldownUntil = 0;
      let cooldownTimer;

      const setStatus = (message, state = 'idle', moveFocus = true) => {
        if (status instanceof HTMLElement) {
          status.textContent = message;
          status.dataset.state = state;
          if (moveFocus && message) status.focus();
        }
      };
      const setCooldownMessage = () => {
        if (!(cooldown instanceof HTMLElement)) return;
        const seconds = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
        cooldown.textContent = seconds > 0 ? `You can request another message in ${seconds} seconds.` : '';
        if (seconds <= 0 && cooldownTimer !== undefined) {
          window.clearInterval(cooldownTimer);
          cooldownTimer = undefined;
        }
      };
      const startCooldown = () => {
        cooldownUntil = Date.now() + 30_000;
        setCooldownMessage();
        cooldownTimer = window.setInterval(setCooldownMessage, 1000);
      };
      const resetVerification = () => {
        tokenReject?.(new Error('turnstile_failed'));
        tokenResolve = undefined;
        tokenReject = undefined;
        if (widgetId !== undefined && window.turnstile) window.turnstile.reset(widgetId);
      };
      const renderTurnstile = () => {
        if (!window.turnstile || !turnstileContainer || !siteKey || widgetId !== undefined) return false;
        widgetId = window.turnstile.render(turnstileContainer, {
          sitekey: siteKey,
          action: 'verification_resend',
          appearance: 'interaction-only',
          execution: 'execute',
          callback: (value) => {
            tokenResolve?.(value);
            tokenResolve = undefined;
            tokenReject = undefined;
          },
          'expired-callback': resetVerification,
          'error-callback': resetVerification,
        });
        return true;
      };
      let attempts = 0;
      const renderTimer = window.setInterval(() => {
        attempts += 1;
        if (renderTurnstile() || attempts >= 100) window.clearInterval(renderTimer);
      }, 100);
      const requestToken = async () => {
        const rendered = widgetId !== undefined || renderTurnstile();
        if (!siteKey || !rendered || widgetId === undefined || !window.turnstile) throw new Error('turnstile_unavailable');
        return new Promise((resolve, reject) => {
          tokenResolve = resolve;
          tokenReject = reject;
          window.turnstile.execute(widgetId);
        });
      };
      const messageFor = (code) => {
        if (code === 'invalid_email') return 'Enter a valid email address.';
        if (code === 'rate_limit_exceeded') return 'Too many requests. Please wait and try again.';
        if (code === 'turnstile_failed' || code === 'turnstile_required' || code === 'turnstile_unavailable') return 'We could not verify this request. Please try again.';
        return 'We could not send a verification email. Please try again.';
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (isSubmitting || !(email instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
        email.removeAttribute('aria-invalid');
        if (!email.validity.valid) {
          email.setAttribute('aria-invalid', 'true');
          email.reportValidity();
          setStatus('Enter a valid email address.', 'error');
          return;
        }
        if (Date.now() < cooldownUntil) {
          setCooldownMessage();
          return;
        }
        isSubmitting = true;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Sending...';
        setStatus('', 'submitting');
        try {
          const turnstileToken = await requestToken();
          const response = await fetch(`${apiBaseUrl}/api/auth/email`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ mode: 'resend_verification', email: email.value, turnstileToken }),
            cache: 'no-store',
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok || body.state !== 'verification_required') throw new Error(typeof body.error === 'string' ? body.error : 'verification_resend_failed');
          startCooldown();
          setStatus('If this account is eligible, your verification request was accepted. Check your inbox; delivery is not confirmed yet.', 'success');
        } catch (error) {
          setStatus(messageFor(error instanceof Error ? error.message : 'verification_resend_failed'), 'error');
        } finally {
          resetVerification();
          button.setAttribute('aria-busy', 'false');
          if (Date.now() >= cooldownUntil) button.disabled = false;
          button.textContent = 'Resend verification email';
          isSubmitting = false;
        }
      });

      const queryEmail = new URL(window.location.href).searchParams.get('email')?.trim();
      if (queryEmail && email instanceof HTMLInputElement && !email.value) email.value = queryEmail;
      if (window.location.search) window.history.replaceState(null, '', '/resend-verification');
    }
  </script>
</BaseLayout>

<style>
  .auth-page { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.7fr); gap: clamp(48px, 10vw, 140px); align-items: start; padding: clamp(82px, 13vw, 150px) 0 120px; }
  .auth-intro h1 { margin-top: 22px; }
  .auth-intro p { max-width: 520px; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .auth-form { display: grid; gap: 10px; padding: 30px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .auth-form label { color: var(--muted); font-size: 13px; }
  .auth-form input { width: 100%; min-height: 50px; padding: 0 15px; color: var(--text); background: #0d0f10; border: 1px solid var(--line-strong); border-radius: 10px; outline: none; }
  .auth-form input:focus { border-color: rgba(223,231,220,.7); box-shadow: 0 0 0 3px rgba(223,231,220,.08); }
  .auth-form input[aria-invalid='true'] { border-color: #f1a7a0; }
  .auth-field-note, .auth-footnote { margin: 0 0 8px; color: var(--quiet); font-size: 12px; line-height: 1.5; }
  .auth-footnote { margin-top: 4px; }
  .auth-turnstile-shell { min-height: 65px; margin: 8px 0; }
  .auth-status { min-height: 24px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .auth-status:focus { outline: 2px solid var(--accent); outline-offset: 4px; }
  .auth-status[data-state='error'] { color: #f1a7a0; }
  .auth-status[data-state='success'] { color: #b8d5b5; }
  @media (max-width: 760px) { .auth-page { grid-template-columns: 1fr; padding-top: 72px; } .auth-form { padding: 22px; } }
</style>
