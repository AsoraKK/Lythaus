---
import SecondaryLayout from '../../layouts/SecondaryLayout.astro';
---
<SecondaryLayout
  title="Contact"
  description="Get in touch with the Lythaus team."
  canonicalPath="/contact"
>
  <section class="section">
    <span class="eyebrow">Help and support</span>
    <h1>Contact Lythaus</h1>
    <p>Find account guidance in <a href="/help">Help</a>, or use the contact details published in our policies.</p>
    <div class="contact-options">
      <div>
        <h2>General support</h2>
        <p><a class="text-link" href="mailto:support@lythaus.app">support@lythaus.app</a></p>
        <p>This opens your email app. Do not include passwords, verification links, or reset tokens.</p>
      </div>
      <div>
        <h2>Privacy and safety</h2>
        <p>For personal data requests, see the <a href="/privacy#contact">Privacy Policy</a>. For reporting and appeals guidance, see the <a href="/guidelines#appeals">Community Guidelines</a>.</p>
      </div>
    </div>
  </section>
</SecondaryLayout>
