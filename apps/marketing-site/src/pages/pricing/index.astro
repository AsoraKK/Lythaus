---
import SecondaryLayout from '../../layouts/SecondaryLayout.astro';
---
<SecondaryLayout
  title="Pricing"
  description="Free to join. Benefits from $5. Join the Lythaus waitlist for updates."
  canonicalPath="/pricing"
>
  <section class="section section--wide">
    <h1>Pricing</h1>
    <p>
      <strong>Free to join. Benefits from $5.</strong> Join the waitlist for updates as we build the platform.
    </p>

    <div class="grid">
      <div class="card">
        <h2>Free to join</h2>
        <p class="price">Free</p>
        <p>Joining the waitlist is free. It does not guarantee an invitation
          or an access date.</p>
        <p><a class="button primary" href="/#waitlist">Join the waitlist</a></p>
      </div>

      <div class="card">
        <h2>Optional paid benefits</h2>
        <p class="price">From $5</p>
        <p>
          Details of paid benefits will be shared when confirmed.
          Paid membership does not buy reputation, Editorial recognition
          or different moderation treatment.
        </p>
      </div>
    </div>
  </section>
</SecondaryLayout>
