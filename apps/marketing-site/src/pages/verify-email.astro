---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';

const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.lythaus.co';
---

<SecondaryLayout
  title="Confirm your email"
  description="Confirm the email address for your Lythaus account."
  canonicalPath="/verify-email"
  noReferrer
  noIndex
>
  <section class="auth-page auth-page--single" aria-labelledby="verify-email-title">
    <div class="auth-intro">
      <span class="pill">Lythaus account</span>
      <h1 id="verify-email-title">Confirm your email.</h1>
      <p>Confirm your email and set the password you will use to sign in. Opening this page does not change your account. Only the mailbox owner can finish setup.</p>

      <form class="auth-form" data-email-verification-form data-api-base-url={publicApiBaseUrl} novalidate>
        <div class="auth-fields" data-email-verification-fields>
          <label for="verification-password">Set your password</label>
          <input id="verification-password" name="password" type="password" autocomplete="new-password" maxlength="256" required aria-describedby="verification-password-note" />
          <p class="auth-field-note" id="verification-password-note">Choose 15–128 characters. This becomes your account password. Spaces, Unicode, paste, and password managers are supported.</p>
          <button class="button primary" type="submit" data-email-verification-submit>Verify email and finish setup</button>
        </div>
        <p class="auth-status" data-email-verification-status aria-live="polite" aria-atomic="true" role="status" tabindex="-1"></p>
        <div class="auth-actions">
          <a class="button secondary" data-email-verification-signin href="/sign-in" hidden>Sign in to Lythaus</a>
          <a class="text-link" data-email-verification-resend href="/resend-verification" hidden>Request a new verification email</a>
        </div>
      </form>
    </div>
  </section>

  <script>
    import { authFetch, withAuthDeadline, acceptsPassword, transportErrorMessage } from '../scripts/auth-request';
    const form = document.querySelector('[data-email-verification-form]');
    if (form instanceof HTMLElement) {
      const button = form.querySelector('[data-email-verification-submit]');
      const password = form.querySelector('#verification-password');
      const status = form.querySelector('[data-email-verification-status]');
      const signInLink = form.querySelector('[data-email-verification-signin]');
      const resendLink = form.querySelector('[data-email-verification-resend]');
      const fields = form.querySelector('[data-email-verification-fields]');
      const apiBaseUrl = form.dataset.apiBaseUrl?.replace(/\/$/u, '') ?? '';
      let token = '';
      let linkGeneration = 0;
      let isSubmitting = false;

      const setStatus = (message, state = 'idle', moveFocus = true) => {
        if (!(status instanceof HTMLElement)) return;
        status.textContent = message;
        status.dataset.state = state;
        if (moveFocus && message) status.focus();
      };
      const showLink = (link) => {
        if (link instanceof HTMLElement) link.hidden = false;
      };
      const showInvalidState = (message) => {
        token = '';
        if (password instanceof HTMLInputElement) {
          password.value = '';
          password.disabled = true;
        }
        if (fields instanceof HTMLElement) fields.hidden = true;
        if (button instanceof HTMLButtonElement) button.disabled = true;
        showLink(resendLink);
        setStatus(message, 'error');
      };

      const captureLink = () => {
        token = new URLSearchParams(window.location.hash.slice(1)).get('token') ?? new URL(window.location.href).searchParams.get('token') ?? '';
        window.history.replaceState(null, '', '/verify-email');
        linkGeneration += 1;
        isSubmitting = false;
        if (fields instanceof HTMLElement) fields.hidden = false;
        if (password instanceof HTMLInputElement) {
          password.value = '';
          password.disabled = !token;
        }
        if (button instanceof HTMLButtonElement) {
          button.disabled = !token;
          button.textContent = 'Verify email and finish setup';
          button.setAttribute('aria-busy', 'false');
        }
        for (const link of [signInLink, resendLink]) if (link instanceof HTMLElement) link.hidden = true;
        setStatus('', 'idle', false);
        if (!token) showInvalidState('This verification link is missing or invalid. Request a new verification email.');
      };
      captureLink();
      window.addEventListener('hashchange', captureLink);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (isSubmitting || !token || !(button instanceof HTMLButtonElement)) return;
        if (!(password instanceof HTMLInputElement)) return;
        if (!acceptsPassword(password.value, 'creation')) {
          password.setAttribute('aria-invalid', 'true');
          setStatus('Use a password between 15 and 128 characters.', 'error');
          return;
        }
        password.removeAttribute('aria-invalid');
        isSubmitting = true;
        const generation = linkGeneration;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        setStatus('Confirming your email...', 'submitting');
        try {
          const response = await authFetch(`${apiBaseUrl}/api/auth/email/verify`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token, password: password.value }),
            cache: 'no-store',
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
          });
          const body = await response.json().catch(() => ({}));
          if (generation !== linkGeneration) return;
          const code = typeof body.error === 'string' ? body.error : 'verification_token_invalid';
          if (!response.ok || body.state !== 'verified') throw new Error(code);
          token = '';
          password.value = '';
          password.disabled = true;
          if (fields instanceof HTMLElement) fields.hidden = true;
          button.textContent = 'Email verified';
          showLink(signInLink);
          setStatus('Your email is verified. You can now sign in to Lythaus.', 'success');
        } catch (error) {
          if (generation !== linkGeneration) return;
          const code = error instanceof Error ? error.message : 'verification_token_invalid';
          if (code === 'verification_token_invalid') {
            showInvalidState('This verification link is invalid, expired, or already used. Request a new verification email.');
          } else {
            button.disabled = false;
            setStatus(transportErrorMessage(code) ?? (code === 'invalid_password' ? 'Choose a password with 15–128 characters.' : 'We could not finish setup. The result is not confirmed. Try again, or use sign-in/recovery if this request was interrupted.'), 'error');
          }
        } finally {
          if (generation === linkGeneration) {
            button.setAttribute('aria-busy', 'false');
            isSubmitting = false;
          }
        }
      });
    }
  </script>
</SecondaryLayout>
