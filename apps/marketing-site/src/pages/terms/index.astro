---
import SecondaryLayout from '../../layouts/SecondaryLayout.astro';
import ArticleContents from '../../components/ArticleContents.astro';
const articleSections = [
  {
    "id": "service-overview",
    "title": "1. Service overview"
  },
  {
    "id": "accounts-and-access",
    "title": "2. Accounts and access"
  },
  {
    "id": "content-rules",
    "title": "3. Content rules"
  },
  {
    "id": "safety-and-moderation",
    "title": "4. Safety and moderation"
  },
  {
    "id": "prohibited-conduct",
    "title": "5. Prohibited conduct"
  },
  {
    "id": "termination",
    "title": "6. Termination"
  },
  {
    "id": "disclaimers-and-liability",
    "title": "7. Disclaimers and liability"
  },
  {
    "id": "changes",
    "title": "8. Changes"
  },
  {
    "id": "contact",
    "title": "9. Contact"
  }
];
---
<SecondaryLayout title="Terms of Service" description="Lythaus terms of service." canonicalPath="/terms">
  <section class="legal">
    <span class="pill">Legal</span>
    <h1>Terms of Service</h1>
    <p class="meta">Last Updated: February 2026 · Product: Lythaus</p>

    <ArticleContents sections={articleSections} />

    <h2 id="service-overview">1. Service overview</h2>
    <p>Lythaus is a social platform centered on authentic human-created content and news.</p>

    <h2 id="accounts-and-access">2. Accounts and access</h2>
    <ul>
      <li>Users are responsible for account credentials.</li>
      <li>Guest access may be available for limited read-only usage.</li>
      <li>Access may be suspended for abuse or policy violations.</li>
    </ul>

    <h2 id="content-rules">3. Content rules</h2>
    <ul>
      <li>Users must post only content they have rights to share.</li>
      <li>AI-generated content is not publishable.</li>
      <li>Moderation decisions can be appealed and are reviewed by authorised staff during the alpha.</li>
    </ul>

    <h2 id="safety-and-moderation">4. Safety and moderation</h2>
    <ul>
      <li>Users can report content and submit appeals.</li>
      <li>Safety actions are audit logged; appeal outcomes follow trained reviewer-panel and adjudicator governance, not unilateral overrides.</li>
    </ul>

    <h2 id="prohibited-conduct">5. Prohibited conduct</h2>
    <p>Illegal content, harassment, fraud, impersonation, and abuse are prohibited. Attempts to evade enforcement or misuse safety systems are prohibited.</p>

    <h2 id="termination">6. Termination</h2>
    <p>Accounts may be limited or terminated for violations or legal risk.</p>

    <h2 id="disclaimers-and-liability">7. Disclaimers and liability</h2>
    <p>Service is provided on an "as available" basis. Liability limitations apply to the maximum extent permitted by law.</p>

    <h2 id="changes">8. Changes</h2>
    <p>We may update these terms and publish a revised effective date.</p>

    <h2 id="contact">9. Contact</h2>
    <p>Support: <a href="mailto:support@lythaus.app">support@lythaus.app</a></p>
  </section>
</SecondaryLayout>
