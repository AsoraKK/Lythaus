---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Check your email"
  description="Continue your Lythaus account setup from your email."
  canonicalPath="/check-email"
>
  <section class="auth-page auth-page--single" aria-labelledby="check-email-title">
    <div class="auth-intro">
      <span class="pill">Lythaus account</span>
      <h1 id="check-email-title">Check your email.</h1>
      <p>
        We received your request. If the account is eligible, a message has been queued or is on its way.
        Delivery can take a few minutes, and this page does not confirm delivery.
      </p>
      <div class="auth-actions">
        <a class="button primary" href="/sign-in">Return to sign in</a>
        <a class="text-link" href="/resend-verification">Resend verification</a>
        <a class="text-link" href="/forgot-password">Reset your password</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page { display: grid; grid-template-columns: minmax(0, 720px); justify-content: center; align-items: start; padding: clamp(82px, 13vw, 150px) 0 120px; }
  .auth-page--single { min-height: 52vh; }
  .auth-intro { text-align: center; }
  .auth-intro h1 { margin-top: 22px; }
  .auth-intro p { max-width: 620px; margin: 22px auto 0; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .auth-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px; margin-top: 34px; }
  .auth-actions .text-link { color: var(--muted); font-weight: 500; }
  .auth-actions .text-link:hover { color: var(--text); }
  @media (max-width: 560px) { .auth-page { padding-top: 72px; } .auth-actions { align-items: flex-start; flex-direction: column; } }
</style>
