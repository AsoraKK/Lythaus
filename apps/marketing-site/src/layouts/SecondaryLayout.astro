---
import tokens from '../../../../design/tokens.json';
import ApprovedBrand from '../components/ApprovedBrand.astro';
import regularFont from '../../../../assets/fonts/Manrope-Regular.ttf?url';
import semiboldFont from '../../../../assets/fonts/Manrope-SemiBold.ttf?url';
import '../styles/palette.css';
import '../styles/brand.css';
import '../styles/secondary.css';

const {
  title = 'Lythaus',
  description = 'A calm, human-first publishing network.',
  canonicalPath = '',
  absoluteTitle = false,
  noReferrer = false,
  noIndex = false,
} = Astro.props;
const pageTitle = absoluteTitle ? title : `${title} | Lythaus`;
const siteUrl = Astro.site?.origin ?? 'https://lythaus.co';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const socialImageUrl = `${siteUrl}/brand/lythaus-four-colour/lythaus-social-card-1200x630.871084ba8f81.png`;
const navigation = [
  { href: '/features', label: 'Features' },
  { href: '/about', label: 'About' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/help', label: 'Help' },
];
const helpArticle = ['/privacy', '/terms', '/guidelines', '/ai-moderation', '/contact'].includes(canonicalPath);
const foundationCss = `html[data-secondary]{--ds-radius-control:${tokens.radius.control}px;--ds-radius-surface:${tokens.radius.surface}px;--ds-target:${tokens.layout.webTarget}px;--ds-article-width:${tokens.layout.articleWidth}px;--ds-motion:${tokens.motion.control}ms;--ds-brand-surface:${tokens.color.dark.canvas}}`;
const fontCss = `@font-face{font-family:"Lythaus Interface";src:url("${regularFont}") format("truetype");font-weight:400;font-style:normal;font-display:swap}@font-face{font-family:"Lythaus Interface";src:url("${semiboldFont}") format("truetype");font-weight:600 800;font-style:normal;font-display:swap}`;
---
<!doctype html>
<html lang="en" data-secondary data-appearance="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="theme-color" content={tokens.color.dark.canvas} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/icons/lythaus-four-colour/favicon.843c17f8b307.svg" />
    <link rel="icon" type="image/png" href="/icons/lythaus-four-colour/favicon-96x96.de330b9cd99a.png" sizes="96x96" />
    <link rel="icon" type="image/x-icon" href="/icons/lythaus-four-colour/favicon.b3b17204ae17.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" type="image/png" href="/icons/lythaus-four-colour/apple-touch-icon.9a0cab560dae.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Lythaus" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lythaus wordmark" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Lythaus wordmark" />
    <link rel="preload" as="font" type="font/ttf" href={regularFont} crossorigin />
    <style is:inline set:html={fontCss + foundationCss} />
  </head>
  <body class="secondary-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="secondary-header">
      <a class="secondary-brand" href="/" aria-label="Lythaus home">
        <span class="brand-symbol-slot approved-brand" aria-hidden="true"><ApprovedBrand variant="symbol" /></span>
      </a>
      <nav class="secondary-nav" aria-label="Main navigation">
        {navigation.map(({ href, label }) => <a href={href} aria-current={canonicalPath === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="secondary-header-actions">
        <a class="button secondary app-link" href="https://app.lythaus.co">Open app <span aria-hidden="true">↗</span></a>
        <details class="secondary-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            {navigation.map(({ href, label }) => <a href={href} aria-current={canonicalPath === href ? 'page' : undefined}>{label}</a>)}
            <a href="/sign-in">Sign in</a>
            <a href="https://app.lythaus.co">Open app</a>
          </nav>
        </details>
      </div>
    </header>
    <main class="secondary-main" id="main-content" tabindex="-1">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {helpArticle && <li><a href="/help">Help</a></li>}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      <slot />
    </main>
    <footer class="secondary-footer">
      <div class="footer-intro"><a class="secondary-brand" href="/" aria-label="Lythaus home"><span class="secondary-brand-wordmark approved-brand" aria-hidden="true"><ApprovedBrand /></span></a><p>A calmer place for human ideas.</p></div>
      <nav aria-label="Footer navigation">
        <a href="/help">Help</a><a href="/contact">Contact</a><a href="/guidelines">Guidelines</a>
        <a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/invite">Redeem invite</a>
      </nav>
    </footer>
    <script is:inline>
      (() => {
        document.querySelectorAll('.auth-form input[type="password"]').forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          const field = document.createElement('div');
          field.className = 'password-field';
          input.replaceWith(field);
          field.append(input);
          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'password-toggle';
          toggle.textContent = 'Show';
          const fieldLabel = input.labels?.[0]?.textContent?.toLowerCase() || 'password';
          toggle.setAttribute('aria-label', `Show ${fieldLabel}`);
          toggle.setAttribute('aria-controls', input.id);
          toggle.addEventListener('click', () => {
            const visible = input.type === 'password';
            input.type = visible ? 'text' : 'password';
            toggle.textContent = visible ? 'Hide' : 'Show';
            toggle.setAttribute('aria-label', `${visible ? 'Hide' : 'Show'} ${fieldLabel}`);
          });
          field.append(toggle);
        });
        const menu = document.querySelector('.secondary-menu');
        if (menu instanceof HTMLDetailsElement) {
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu.open) {
              menu.open = false;
              menu.querySelector('summary').focus();
            }
          });
          document.addEventListener('click', (event) => {
            if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
          });
        }
      })();
    </script>
  </body>
</html>
