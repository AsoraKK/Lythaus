---
import ApprovedBrand from './ApprovedBrand.astro';
import '../styles/home-opening.css';
---
<h1 class="pitch-wordmark" id="pitch-wordmark" aria-label="Lythaus">
  <span class="wordmark-fallback approved-brand" aria-hidden="true"><ApprovedBrand /></span>
  <svg class="wordmark-scene" viewBox="0 0 1000 166" aria-hidden="true" focusable="false">
    <defs>
      <image id="wordmark-material" href="/brand/lythaus-v1/lythaus-wordmark-white.5ba0451347e2.svg" x="0" y="0" width="1000" height="166" preserveAspectRatio="xMidYMid meet" />
      <mask id="wordmark-contours" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="166" style="mask-type: alpha"><use href="#wordmark-material" /></mask>
      <clipPath id="wordmark-space"><rect x="-600" y="-500" width="2300" height="1150" /></clipPath>
      <linearGradient id="wordmark-exposure-edge">
        <stop offset="0" stop-color="var(--ds-text)" />
        <stop offset="1" stop-color="var(--ds-text)" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="wordmark-reflection">
        <stop stop-color="var(--ds-text)" />
        <stop offset=".16" stop-color="var(--light-ivory)" stop-opacity=".98" />
        <stop class="wordmark-reflection-shoulder" offset=".48" stop-color="var(--light-ivory)" stop-opacity=".5" />
        <stop offset="1" stop-color="var(--light-gold)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="wordmark-bloom">
        <stop stop-color="var(--ds-text)" stop-opacity=".96" />
        <stop offset=".12" stop-color="var(--light-ivory)" stop-opacity=".9" />
        <stop offset=".36" stop-color="var(--light-gold)" stop-opacity=".5" />
        <stop offset="1" stop-color="var(--light-gold)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="wordmark-atmosphere">
        <stop stop-color="var(--light-ivory)" stop-opacity=".8" />
        <stop offset=".35" stop-color="var(--light-gold)" stop-opacity=".55" />
        <stop offset=".68" stop-color="var(--light-gold)" stop-opacity=".1" />
        <stop offset="1" stop-color="var(--light-gold)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="wordmark-core">
        <stop offset="0" stop-color="var(--ds-text)" />
        <stop offset=".3" stop-color="var(--ds-text)" />
        <stop offset="1" stop-color="var(--light-ivory)" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="wordmark-projection" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="var(--light-gold)" stop-opacity="0" />
        <stop offset=".35" stop-color="var(--light-gold)" stop-opacity=".18" />
        <stop offset=".5" stop-color="var(--light-ivory)" stop-opacity=".52" />
        <stop offset=".65" stop-color="var(--light-gold)" stop-opacity=".18" />
        <stop offset="1" stop-color="var(--light-gold)" stop-opacity="0" />
      </linearGradient>
      <mask id="wordmark-exposure" maskUnits="userSpaceOnUse" x="-110" y="-140" width="1220" height="450" style="mask-type: alpha">
        <g data-light-position>
          <rect x="-1300" y="-20" width="1288" height="210" fill="var(--ds-text)" />
          <rect x="-12" y="-20" width="12" height="210" fill="url(#wordmark-exposure-edge)" />
        </g>
      </mask>
    </defs>
    <g clip-path="url(#wordmark-space)">
      <rect class="wordmark-dark" x="0" y="0" width="1000" height="166" mask="url(#wordmark-contours)" />
      <g class="wordmark-reveal" mask="url(#wordmark-exposure)">
        <rect class="wordmark-settled" x="0" y="0" width="1000" height="166" mask="url(#wordmark-contours)" />
      </g>
      <g class="wordmark-optics" visibility="hidden">
        <g data-light-energy>
          <path data-light-projection d="M0 0 Q.45 -12 1 -100 V100 Q.45 12 0 0Z" fill="url(#wordmark-projection)" />
          <g clip-path="url(#wordmark-space)" mask="url(#wordmark-contours)">
            <g data-light-position>
              <ellipse class="wordmark-afterlight" cx="-38" cy="80" rx="80" ry="170" fill="url(#wordmark-reflection)" />
              <ellipse cx="0" cy="80" rx="21" ry="155" fill="url(#wordmark-reflection)" />
            </g>
          </g>
          <g data-light-position data-light-beam>
            <ellipse class="wordmark-atmosphere" cx="-18" cy="80" rx="125" ry="150" fill="url(#wordmark-atmosphere)" />
            <ellipse class="wordmark-bloom" cx="0" cy="80" rx="44" ry="82" fill="url(#wordmark-bloom)" />
          </g>
        </g>
        <g data-light-core data-light-source>
          <ellipse cx="500" cy="80" rx="42" ry="34" fill="url(#wordmark-atmosphere)" opacity=".42" />
          <ellipse cx="500" cy="80" rx="16" ry="12" fill="url(#wordmark-bloom)" />
          <ellipse class="wordmark-core" cx="500" cy="80" rx="3" ry="4" fill="url(#wordmark-core)" />
        </g>
      </g>
    </g>
  </svg>
</h1>
