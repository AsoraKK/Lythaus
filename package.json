{
  "name": "lythaus-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Lythaus platform - Flutter clients with Cloudflare Workers and PlanetScale PostgreSQL",
  "scripts": {
    "prepare": "if [ \"$CI\" = \"true\" ]; then exit 0; fi; command -v npx >/dev/null 2>&1 && npx husky install || true",
    "format-dart": "node scripts/check-dart-format.mjs",
    "format-check": "npm run format-dart",
    "audit:production": "node scripts/check-npm-audit.js",
    "openapi:lint": "redocly lint api/openapi/openapi.yaml",
    "openapi:bundle": "redocly bundle api/openapi/openapi.yaml -o api/openapi/dist/openapi.json --config=api/openapi/redocly.yaml",
    "openapi:validate:examples": "ts-node tools/openapi/validate-examples.ts",
    "openapi:check:bundle": "node scripts/check-git-diff-clean.js api/openapi/dist/openapi.json",
    "openapi:gen:dart": "node scripts/clean-openapi-dart-generated.mjs && openapi-generator-cli generate -g dart-dio -i api/openapi/dist/openapi.json -o lib/generated/api_client --additional-properties=pubName=lythaus_api_client,nullableFields=true,hideGenerationTimestamp=true && node scripts/remove-openapi-oauth-support.mjs lib/generated/api_client && node scripts/trim-trailing-whitespace.js lib/generated/api_client",
    "openapi:test:dart": "node scripts/validate-openapi-dart-client.mjs",
    "openapi:check:dart": "node scripts/check-git-diff-clean.js lib/generated/api_client --ignore lib/generated/api_client/.openapi-generator/FILES",
    "openapi:test:contract": "jest -c jest.contract.config.cjs --runInBand",
    "openapi:docs": "npx @redocly/cli build-docs api/openapi/dist/openapi.json -o api/openapi/dist/index.html",
    "marketing:validate": "node scripts/cloudflare/validate-marketing-output.mjs",
    "marketing:test": "node --test apps/marketing-site/tests/*.test.mjs",
    "k6:diagnose": "bash scripts/diagnose-k6-failures.sh",
    "todo:triage": "node scripts/generate-todo-triage.js",
    "k6:smoke": "node scripts/run-shared-mvp-k6.mjs load/k6/smoke.js",
    "k6:feed": "node scripts/run-shared-mvp-k6.mjs load/k6/feed-read.js",
    "k6:smoke:docker": "node scripts/run-shared-mvp-k6.mjs --docker load/k6/smoke.js",
    "k6:feed:docker": "node scripts/run-shared-mvp-k6.mjs --docker load/k6/feed-read.js",
    "vuln:scan": "bash tools/run_vuln_scan.sh",
    "lint:api": "npm run openapi:lint",
    "validate:native-workers": "node scripts/validate-native-worker-config.mjs",
    "validate:native-workers:provisioned": "node scripts/validate-native-worker-config.mjs --require-provisioned",
    "validate:native-scope": "node scripts/validate-native-scope.mjs",
    "validate:native-scope:production": "node scripts/validate-native-scope.mjs --production",
    "validate:no-retired-provider-dependencies": "node scripts/validate-no-retired-provider-dependencies.mjs",
    "validate:workflow-action-pins": "node scripts/validate-workflow-action-pins.mjs",
    "validate:production-release-contract": "node scripts/validate-production-release-contract.mjs",
    "validate:release-manifest": "node scripts/ci/build-release-manifest.mjs",
    "validate:cloudflare-hyperdrive-targets": "node scripts/ci/verify-cloudflare-hyperdrive-targets.mjs",
    "validate:cloudflare-hyperdrive-targets:manifest": "node scripts/ci/verify-cloudflare-hyperdrive-targets.mjs --manifest-only",
    "validate:production-workers": "node scripts/ci/probe-production-workers.mjs",
    "validate:ai-gateway-paths": "node scripts/ci/verify-ai-gateway-paths.mjs",
    "validate:budget-hard-stop": "node scripts/ci/probe-budget-hard-stop.mjs",
    "acceptance:adr003": "node scripts/ci/run-adr003-with-canonical-schema.mjs",
    "validate:lythaus-resource-registry": "node scripts/validate-lythaus-resource-registry.mjs",
    "validate:production-gates": "node scripts/validate-production-gates.mjs",
    "validate:production-gates:predeploy": "node scripts/validate-production-gates.mjs --phase predeploy",
    "validate:production-gates:final": "node scripts/validate-production-gates.mjs --phase final",
    "typecheck:native": "tsc -p tsconfig.native.json --noEmit",
    "test:native-architecture": "node --experimental-strip-types --experimental-test-module-mocks --test scripts/tests/native-architecture-invariants.test.js scripts/tests/ensure-cloudflare-worker-parent.test.mjs scripts/tests/production-release-governance.test.mjs scripts/tests/release-classification.test.mjs scripts/tests/component-deployment-plan.test.mjs scripts/tests/failure-domains.test.mjs scripts/tests/release-state.test.mjs scripts/tests/auth-acceptance-provenance.test.mjs scripts/tests/exact-release-evidence.test.mjs scripts/tests/resolve-release-plan.test.mjs scripts/tests/release-manifest.test.mjs scripts/tests/release-manifest-workflow.test.js scripts/tests/resolve-worker-version-state.test.mjs scripts/tests/acceptance-rollback-snapshot.test.mjs scripts/tests/scoped-worker-key-lifecycle.test.mjs scripts/tests/cloudflare-email-lifecycle-contract.test.mjs scripts/tests/collect-auth-acceptance-evidence.test.mjs scripts/tests/real-email-acceptance-evidence.test.mjs apps/lythaus-auth-acceptance-coordinator/tests/acceptance-contract.test.mjs scripts/tests/dependency-review-policy.test.mjs packages/contracts/tests/auth-state-and-email-policy.test.mjs apps/lythaus-public-api/tests/auth-runtime-policy.test.mjs apps/lythaus-public-api/tests/waitlist-handler-invariants.test.mjs apps/lythaus-jobs/tests/transactional-email-runtime.test.mjs apps/lythaus-admin-api/tests/admin-cors-policy.test.mjs apps/lythaus-admin-api/tests/admin-runtime-policy.test.mjs apps/lythaus-admin-api/tests/keeper-contract.test.mjs apps/lythaus-admin-api/tests/request-body-policy.test.mjs apps/lythaus-admin-api/tests/waitlist-handler-invariants.test.mjs apps/lythaus-admin-api/tests/waitlist-handler.test.mjs",
    "test:release-governance": "node --test scripts/tests/release-classification.test.mjs scripts/tests/component-deployment-plan.test.mjs scripts/tests/failure-domains.test.mjs scripts/tests/release-state.test.mjs scripts/tests/auth-acceptance-provenance.test.mjs scripts/tests/exact-release-evidence.test.mjs scripts/tests/resolve-release-plan.test.mjs scripts/tests/release-manifest.test.mjs scripts/tests/release-manifest-workflow.test.js scripts/tests/production-release-governance.test.mjs scripts/tests/resolve-worker-version-state.test.mjs scripts/tests/acceptance-rollback-snapshot.test.mjs scripts/tests/scoped-worker-key-lifecycle.test.mjs scripts/tests/real-email-acceptance-evidence.test.mjs apps/lythaus-auth-acceptance-coordinator/tests/acceptance-contract.test.mjs",
    "test:native-db-connection": "node --experimental-strip-types --test scripts/tests/db-connection-contract.test.mjs",
    "test:database-identity": "node --experimental-strip-types --test scripts/tests/db-identity-contract.test.mjs",
    "test:budget": "node --experimental-strip-types --test scripts/tests/budget-contract.test.mjs",
    "test:authenticity": "node --experimental-strip-types --test packages/authenticity/tests/evaluation.test.mjs",
    "test:authenticity-foundation": "node --experimental-strip-types --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test packages/authenticity/tests/evaluation.test.mjs packages/authenticity/tests/foundation.test.mjs packages/authenticity/tests/wp002.test.mjs packages/authenticity/tests/wp003.test.mjs",
    "test:authenticity-wp003": "node --experimental-strip-types --test packages/authenticity/tests/wp003.test.mjs",
    "test:product-contracts": "node --experimental-strip-types --test packages/contracts/tests/product-policy.test.mjs",
    "test:product-integrity-runtime": "node --test scripts/tests/product-integrity-runtime-invariants.test.mjs",
    "test:critical-coverage": "node scripts/critical-coverage-gate.mjs",
    "ml:thermal-qualify": "node ml/local/eco_train/thermal-qualify.mjs --plan",
    "validate:planetscale-migrations": "node scripts/validate-migration-baseline.mjs",
    "validate:planetscale-extensions": "node scripts/validate-planetscale-extensions.mjs",
    "validate:planetscale-extensions:live": "node scripts/validate-planetscale-extensions.mjs --require-catalog",
    "validate:planetscale-postgres17": "node scripts/ci/validate-planetscale-postgres17.mjs",
    "benchmark:native-endpoints": "node scripts/benchmarks/native-endpoint-benchmark.mjs",
    "validate:planetscale-ci-script": "node --check scripts/ci/apply-planetscale-migrations.mjs",
    "validate:planetscale-production-script": "node --check scripts/ci/apply-planetscale-production-migrations.mjs",
    "apply:planetscale-production-migrations": "node scripts/ci/apply-planetscale-production-migrations.mjs",
    "reconcile:planetscale-migrations": "node scripts/ci/reconcile-planetscale-migration-state.mjs",
    "test:planetscale-production-migrations": "node --test scripts/tests/planetscale-production-migrations.test.mjs scripts/tests/planetscale-schema-verifier-views.test.mjs"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "@redocly/cli": "^2.5.0",
    "@stoplight/spectral-cli": "6.15.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-fetch": "^4.1.0",
    "glob": "^13.0.6",
    "husky": "^8.0.3",
    "jest": "^30.4.2",
    "jsonpointer": "^5.0.1",
    "oasdiff": "file:tools/openapi/oasdiff",
    "openapi-client-axios": "^7.7.0",
    "playwright": "^1.60.0",
    "tesseract.js": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "wrangler": "^4.114.0",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "concurrently@10.0.3": {
      "shell-quote": "1.10.0"
    },
    "@stoplight/spectral-cli": {
      "@stoplight/spectral-core": "1.20.0",
      "@stoplight/spectral-formatters": "1.5.0",
      "@stoplight/spectral-ruleset-bundler": "1.7.0",
      "@stoplight/spectral-ruleset-migrator": "1.11.3",
      "@stoplight/spectral-rulesets": "1.22.0",
      "@stoplight/spectral-runtime": "1.1.4"
    },
    "@stoplight/spectral-functions": "1.10.1",
    "@stoplight/spectral-formats": "1.8.2",
    "@stoplight/spectral-ruleset-bundler": "1.7.0",
    "@stoplight/spectral-ruleset-migrator": "1.11.3",
    "@stoplight/spectral-rulesets": "1.22.0",
    "@stoplight/spectral-runtime": "1.1.4",
    "@stoplight/spectral-core": "1.20.0",
    "glob@10.5.0": {
      "minimatch": "10.2.6"
    },
    "brace-expansion": "5.0.9",
    "fast-xml-parser": "5.10.1",
    "fast-uri": "3.1.7",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "minimatch": "10.2.6",
    "test-exclude": {
      "minimatch": "5.1.9"
    },
    "typescript": "5.5.4",
    "undici": "7.29.0",
    "miniflare": {
      "undici": "7.29.0"
    }
  },
  "workspaces": [
    "apps/lythaus-auth-acceptance-coordinator",
    "apps/lythaus-admin-api",
    "apps/lythaus-jobs",
    "apps/lythaus-public-api",
    "packages/cloudflare-env",
    "packages/authenticity",
    "packages/contracts",
    "packages/db",
    "packages/media",
    "packages/observability",
    "packages/security"
  ],
  "keywords": [
    "flutter",
    "dart",
    "cloudflare-workers",
    "planetscale",
    "typescript",
    "monorepo"
  ],
  "author": "Lythaus",
  "license": "MIT"
}
